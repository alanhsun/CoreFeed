{
  "name": "corefeed",
  "version": "2.0.0",
  "description": "CoreFeed v2.0 - Global News Collector, Cross-Source Verifier & Reader",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop news-aggregator",
    "pm2:restart": "pm2 restart news-aggregator",
    "pm2:logs": "pm2 logs news-aggregator",
    "pm2:monit": "pm2 monit",
    "docker:build": "docker build -t news-aggregator .",
    "docker:run": "docker run -d --name news-aggregator -p 3120:3120 --env-file .env news-aggregator",
    "docker:stop": "docker stop news-aggregator && docker rm news-aggregator",
    "docker:logs": "docker logs news-aggregator",
    "compose:up": "docker-compose up -d",
    "compose:down": "docker-compose down",
    "compose:logs": "docker-compose logs -f",
    "health": "curl -f http://localhost:3120/api/health",
    "setup": "npm install && cp .env.example .env",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "test": "node -e \"const app = require('./server.js'); console.log('Syntax & Module Load Check Passed'); process.exit(0);\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "news",
    "agent",
    "ai",
    "translation",
    "aggregator"
  ],
  "author": "Alan Sun",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
