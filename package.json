{
  "name": "corefeed",
  "version": "2.0.0",
  "description": "CoreFeed v2.0 - Global News Collector, Cross-Source Verifier & Reader",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop corefeed",
    "pm2:restart": "pm2 restart corefeed",
    "pm2:logs": "pm2 logs corefeed",
    "pm2:monit": "pm2 monit",
    "docker:build": "docker build -t corefeed:2.0 .",
    "docker:run": "docker run -d --name corefeed -p 3120:3120 --env-file .env corefeed:2.0",
    "docker:stop": "docker stop corefeed && docker rm corefeed",
    "docker:logs": "docker logs corefeed",
    "compose:up": "docker-compose up -d",
    "compose:down": "docker-compose down",
    "compose:logs": "docker-compose logs -f",
    "health": "curl -f http://localhost:3120/api/health",
    "setup": "npm install && cp .env.example .env",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "ag:harvest": "node scripts/ag-harvest.js",
    "ag:publish": "node scripts/ag-publish.js",
    "ag:publish:github": "node scripts/ag-publish.js --github --local-only",
    "ag:auto": "node scripts/ag-auto-update.js",
    "ag:auto:github": "node scripts/ag-auto-update.js --github",
    "test": "node --test tests/ag_pipeline.test.js tests/deploy_router.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "news",
    "agent",
    "ai",
    "translation",
    "aggregator"
  ],
  "author": "Alan Sun",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
