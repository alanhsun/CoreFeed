<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>智能新闻聚合</title>
    
    <!-- 强化防缓存meta标签 - 完全禁用浏览器缓存 -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate, private, max-age=0">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <meta name="cache-control" content="no-cache, no-store, must-revalidate, private, max-age=0">
    <meta name="expires" content="0">
    <meta name="pragma" content="no-cache">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="referrer" content="no-referrer">
    <meta name="app-version" content="<%= appVersion %>">
    <meta name="timestamp" content="<%= Date.now() %>">
    <meta name="random-id" content="<%= Math.random().toString(36).substr(2, 9) %>">
    
    <link rel="icon" type="image/svg+xml" href="/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css?v=<%= appVersion %>" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
            .news-card {
                transition: all 0.3s ease;
            }
            .news-card:hover {
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            }
            .loading-dots {
                display: inline-block;
            }
            .loading-dots::after {
                content: '';
                animation: dots 1.5s infinite;
            }
            @keyframes dots {
                0%, 20% { content: ''; }
                40% { content: '.'; }
                60% { content: '..'; }
                80%, 100% { content: '...'; }
            }
        </style>
</head>
<body class="min-h-screen font-sans" style="background-color: var(--bg-primary); color: var(--text-primary);">
    <nav class="header sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4 animate-slide-in-left">
                    <div class="w-10 h-10 rounded-xl overflow-hidden shadow-sm hover-glow">
                        <img src="/images/logo.png" alt="Logo" class="w-full h-full object-cover">
                    </div>
                    <h1 class="text-2xl font-bold hover-scale" style="color: var(--text-primary);">智能新闻聚合</h1>
                </div>
                
                <div class="flex items-center space-x-4 animate-slide-in-right">
                    <!-- 更新时间信息 -->
                    <% if (lastUpdated) { %>
                        <div class="hidden md:flex items-center space-x-1 text-sm" style="color: var(--text-secondary);">
                            <i class="fas fa-clock" style="color: var(--accent-color);"></i>
                            <span><%= new Date(lastUpdated).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) %></span>
                        </div>
                    <% } %>
                    
                    <!-- 深色模式切换 -->
                    <button id="themeToggle" class="btn btn--secondary btn--sm hover-glow" title="切换主题">
                        <i id="themeIcon" class="fas fa-moon text-lg"></i>
                    </button>
                    
                    <!-- 设置按钮 -->
                    <button onclick="openSourceManager()" class="btn btn--secondary btn--sm" title="设置">
                        <i class="fas fa-cog"></i>
                    </button>
                    

                    
                    <!-- 手动刷新按钮 -->
                    <button onclick="refreshNews()" class="btn btn--primary btn--sm" title="手动获取新闻" style="min-width: 100px; white-space: nowrap;">
                        <i class="fas fa-sync-alt"></i>
                        <span class="hidden sm:inline">手动获取</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-12">
            <div class="text-center mb-8 animate-fade-in-up">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl mb-6 shadow-xl hover-glow">
                    <i class="fas fa-globe text-2xl text-white"></i>
                </div>
                <h1 class="text-4xl font-bold mb-4 hover-scale" style="color: var(--text-primary);">
                    今日要闻
                </h1>
                <p class="text-lg max-w-2xl mx-auto leading-relaxed animate-fade-in-up" style="color: var(--text-secondary); animation-delay: 0.2s;">实时聚合全球热点新闻，智能翻译与总结，为您提供最新的国际资讯</p>
            </div>
        </div>



        <!-- 完整版音频播放器 -->
        <div class="mb-12">
            <div class="rounded-xl p-6 shadow-sm" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
                <div class="flex items-center justify-between mb-6 animate-fade-in-up">
                    <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center hover-glow">
                            <i class="fas fa-microphone text-white text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold hover-scale" style="color: var(--text-primary);">音频播报</h3>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3 animate-fade-in-up" style="animation-delay: 0.3s;">
                        <button onclick="downloadCompletePodcast()" class="btn-secondary">
                            <i class="fas fa-file-audio"></i>
                            <span>下载完整音频</span>
                        </button>
                        <button onclick="viewSummary()" class="btn-secondary">
                            <i class="fas fa-file-alt"></i>
                            <span>文字摘要</span>
                        </button>
                        <button onclick="sendToKindle()" class="btn-primary">
                            <i class="fas fa-envelope"></i>
                            <span>发送摘要到Kindle</span>
                        </button>
                    </div>
                </div>
                
                <!-- 音频播放器 -->
                <div class="mb-6 p-6 rounded-2xl" style="background: var(--bg-primary);">
                    <!-- 顶部信息和控制 -->
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center space-x-4 flex-1 pr-8">
                            <div class="text-sm font-medium min-h-[4.5rem] flex items-center py-2" style="color: var(--text-primary); line-height: 1.5;" id="currentSegmentText">点击播放开始收听</div>
                        </div>
                        <div class="flex flex-col items-end space-y-2">
                            <!-- 音量控制 -->
                            <div class="flex items-center justify-between w-24">
                                <i id="volumeIcon" class="fas fa-volume-up text-sm cursor-pointer hover:scale-110 transition-transform duration-200" style="color: var(--text-secondary);" onclick="toggleMute()" title="点击静音/取消静音"></i>
                                <input type="range" id="volumeSlider" min="0" max="100" value="100" 
                                       class="w-16 h-1 bg-gray-300 rounded-lg appearance-none cursor-pointer volume-slider"
                                       onchange="adjustVolume(this.value)">
                            </div>
                            <!-- 倍速控制 -->
                            <div class="flex items-center justify-end space-x-2 w-30">
                                <span class="text-xs" style="color: var(--text-secondary);">倍速</span>
                                <select id="playbackRateSelect" onchange="changePlaybackRate(this.value)" 
                                        class="text-xs px-2 py-1 rounded border-0 cursor-pointer w-16" 
                                        style="background: var(--bg-secondary); color: var(--text-primary); font-size: 11px; min-width: 4rem;">
                                    <option value="0.5">0.5x</option>
                                    <option value="0.75">0.75x</option>
                                    <option value="1" selected>1x</option>
                                    <option value="1.25">1.25x</option>
                                    <option value="1.5">1.5x</option>
                                    <option value="2">2x</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 播放控制按钮和进度条 -->
                    <div class="flex items-center space-x-4 mb-4">
                        <!-- 播放控制按钮 -->
                        <div class="audio-controls-group">
                            <button onclick="previousSegment()" class="audio-control audio-control--nav">
                                <i class="fas fa-step-backward text-sm"></i>
                            </button>
                            <button id="playPauseBtn" onclick="togglePlayPause()" class="audio-control audio-control--play">
                                <i id="playPauseIcon" class="fas fa-play"></i>
                            </button>
                            <button onclick="nextSegment()" class="audio-control audio-control--nav">
                                <i class="fas fa-step-forward text-sm"></i>
                            </button>
                        </div>
                        
                        <!-- 播放进度条 -->
                        <div class="flex-1 flex items-center space-x-3">
                            <div class="flex-1">
                                <div class="w-full bg-gray-300 rounded-full h-2 cursor-pointer" onclick="seekAudio(event)">
                                    <div id="audioProgressBar" class="bg-gradient-to-r from-purple-500 to-pink-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                                </div>
                            </div>
                            
                            <div class="text-sm whitespace-nowrap" style="color: var(--text-secondary);">
                                <span id="currentTime">00:00</span> / <span id="totalTime">--:--</span>
                            </div>
                        </div>
                    </div>
                </div>
                

                

            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8" id="news-container">
            <% if (news && news.length > 0) { %>
                <% news.forEach((article, index) => { %>
                     <div class="card group cursor-pointer hover-glow animate-fade-in-up" onclick="openNewsUrl(this)" style="animation-delay: <%= index * 0.1 %>s" data-url="<%= article.url || '' %>">
                         <% if (article.urlToImage) { %>
                             <div class="card__image relative overflow-hidden">
                                 <img src="<%= article.urlToImage %>" class="w-full h-48 object-cover group-hover:scale-110 transition-transform duration-700" alt="新闻图片">
                                 <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                 <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                     <div class="w-8 h-8 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center">
                                         <i class="fas fa-external-link-alt text-white text-xs"></i>
                                     </div>
                                 </div>
                             </div>
                         <% } else { %>
                             <div class="card__image w-full h-48 bg-gradient-to-br from-blue-100 to-purple-100 flex items-center justify-center relative overflow-hidden">
                                 <div class="text-center z-10">
                                     <i class="fas fa-newspaper text-4xl text-blue-400 mb-2"></i>
                                     <p class="text-blue-600 text-sm font-medium">新闻资讯</p>
                                 </div>
                                 <div class="absolute inset-0 bg-gradient-to-br from-blue-200/50 to-purple-200/50"></div>
                             </div>
                         <% } %>
                         <div class="card__content p-6 flex flex-col h-full">
                             <div class="mb-4">
                                 <div class="flex items-center space-x-2 mb-3">
                                     <span class="news-tag news-tag--source hover-scale">
                                         <i class="fas fa-building mr-1 text-xs"></i>
                                         <%= article.source.name %>
                                     </span>
                                     <% if (article.region) { %>
                                         <span class="news-tag news-tag--region hover-scale">
                                             <i class="fas fa-map-marker-alt mr-1"></i>
                                             <%= article.region %>
                                         </span>
                                     <% } %>
                                 </div>
                                 <div class="text-sm flex items-center rounded-full px-3 py-1 w-fit backdrop-blur-sm" style="color: var(--text-secondary); background: var(--bg-glass);">
                                     <i class="fas fa-clock mr-2 animate-pulse" style="color: var(--accent-color);"></i>
                                     <% if (article.publishedAt) { %>
                                         <%= new Date(article.publishedAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) %>
                                     <% } else { %>
                                         <span style="color: var(--text-muted); font-style: italic;">时间未知</span>
                                     <% } %>
                                 </div>
                             </div>
                            
                            <h3 class="card__title text-lg font-bold mb-3 line-clamp-2 group-hover:text-blue-600 transition-all duration-300" style="color: var(--text-primary);">
                                <%= article.translatedTitle || article.title %>
                            </h3>
                            
                            <div class="rounded-lg p-3 mb-3 backdrop-blur-sm" style="background: var(--bg-glass); border: 1px solid var(--border-color);">
                                <p class="text-xs" style="color: var(--text-secondary);">
                                    <strong style="color: var(--text-primary);">原标题:</strong> <%= article.title %>
                                </p>
                            </div>
                            
                            <p class="card__description flex-grow mb-6 line-clamp-3 leading-relaxed" style="color: var(--text-secondary);">
                                <%= article.summary || article.translatedDescription || article.description %>
                            </p>
                            
                            <div class="mt-auto pt-4" style="border-top: 1px solid var(--border-color);">
                                <div class="btn btn--primary btn--sm flex items-center justify-center space-x-2 w-full">
                                     <span>阅读原文</span>
                                     <i class="fas fa-external-link-alt"></i>
                                 </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full">
                    <div class="text-center py-16">
                        <div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl mb-6" style="background: var(--bg-secondary);">
                            <i class="fas fa-newspaper text-3xl" style="color: var(--border-color);"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-3" style="color: var(--text-primary);">暂无新闻数据</h4>
                        <p class="mb-8 max-w-md mx-auto leading-relaxed" style="color: var(--text-secondary);">点击"手动获取"按钮获取最新AI资讯和全球热点新闻</p>
                        <button onclick="refreshNews()" class="btn-primary">
                            <i class="fas fa-sync-alt"></i>
                            <span>立即获取</span>
                        </button>
                    </div>
                </div>
            <% } %>
        </div>
        
        <!-- 加载更多按钮 -->
        <div id="loadMoreContainer" class="text-center mt-12 mb-8" style="display: none;">
            <button id="loadMoreBtn" onclick="loadMoreNews()" class="btn btn--primary btn--lg inline-flex items-center space-x-3 px-8 py-4 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
                <i class="fas fa-plus-circle text-lg"></i>
                <span>加载更多新闻</span>
                <span id="remainingCount" class="bg-white/20 px-2 py-1 rounded-full text-sm font-medium"></span>
            </button>
        </div>
    </main>

    <footer class="py-12 mt-16" style="background: var(--footer-bg); color: var(--footer-text);">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <div class="flex items-center justify-center mb-6">
                    <div class="w-12 h-12 rounded-2xl flex items-center justify-center overflow-hidden shadow-sm mr-4">
                        <img src="/images/logo.png" alt="Logo" class="w-full h-full object-cover">
                    </div>
                    <h3 class="text-2xl font-bold" style="color: var(--footer-text);">智能新闻聚合</h3>
                </div>
                <p class="mb-4 max-w-2xl mx-auto leading-relaxed" style="color: var(--footer-text-secondary);">
                    由AI驱动的智能新闻聚合平台，为您提供全球最新热点新闻
                </p>
                <div class="flex justify-center space-x-6 mb-6">
                    <div class="flex items-center text-sm" style="color: var(--footer-text-muted);">
                        <i class="fas fa-robot mr-2 text-blue-400"></i>
                        <span>AI智能翻译</span>
                    </div>
                    <div class="flex items-center text-sm" style="color: var(--footer-text-muted);">
                        <i class="fas fa-globe mr-2 text-green-400"></i>
                        <span>全球资讯</span>
                    </div>
                    <div class="flex items-center text-sm" style="color: var(--footer-text-muted);">
                        <i class="fas fa-clock mr-2 text-purple-400"></i>
                        <span>实时更新</span>
                    </div>
                </div>
                <div class="pt-6" style="border-top: 1px solid var(--footer-border);">
                    <p class="text-sm" style="color: var(--footer-text-muted);">&copy; 2025 智能新闻聚合. 所有权利保留.</p>
                    <p class="text-xs mt-2" style="color: var(--footer-text-muted);">作者: Alan Sun</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- 现代化加载模态框 -->
    <div id="loadingModal" class="fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm flex items-center justify-center z-50 hidden">
        <div class="bg-white rounded-3xl p-10 max-w-md w-full mx-4 shadow-2xl border border-gray-100">
            <div class="text-center">
                <div class="relative mb-6">
                    <div class="w-16 h-16 mx-auto">
                        <div class="absolute inset-0 rounded-full border-4 border-gray-200"></div>
                        <div class="absolute inset-0 rounded-full border-4 border-blue-500 border-t-transparent"></div>
                        <div class="absolute inset-2 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
                            <i id="loadingIcon" class="fas fa-newspaper text-white text-lg"></i>
                        </div>
                    </div>
                </div>
                <h3 id="loadingTitle" class="text-xl font-bold text-gray-900 mb-3">正在获取新闻</h3>
                <p id="loadingMessage" class="text-gray-600 leading-relaxed mb-4">AI正在为您聚合全球最新资讯...</p>
                
                <!-- 进度条 -->
                <div class="w-full bg-gray-200 rounded-full h-2 mb-4">
                    <div id="progressBar" class="bg-gradient-to-r from-blue-500 to-purple-600 h-2 rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
                </div>
                
                <!-- 进度百分比和详细信息 -->
                <div class="flex justify-between items-center text-sm text-gray-500 mb-4">
                    <span id="progressPercent">0%</span>
                    <span id="progressDetail"></span>
                </div>
                
                <div class="flex justify-center">
                    <div class="flex space-x-1">
                        <div class="w-2 h-2 bg-blue-500 rounded-full animate-bounce"></div>
                        <div class="w-2 h-2 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                        <div class="w-2 h-2 bg-pink-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 摘要文章模态框 -->
    <div id="summaryModal" class="fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm flex items-center justify-center z-50 hidden">
        <div class="rounded-3xl p-8 max-w-4xl w-full mx-4 shadow-2xl border max-h-[90vh] overflow-hidden flex flex-col" style="background: var(--bg-primary); border-color: var(--border-color);">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center">
                        <i class="fas fa-file-alt text-white text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold" style="color: var(--text-primary);" id="summaryTitle">新闻摘要文章</h3>
                        <p class="text-sm" style="color: var(--text-secondary);" id="summaryMeta">AI生成的综合新闻摘要</p>
                    </div>
                </div>
                <button onclick="closeSummaryModal()" class="btn-secondary close-button">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="flex-1 overflow-y-auto" style="scrollbar-width: thin;">
                <div id="summaryContent" class="prose prose-lg max-w-none" style="color: var(--text-primary);">
                    <!-- 摘要内容将在这里显示 -->
                </div>
            </div>
            
            <div class="flex items-center justify-between mt-6 pt-6" style="border-top: 1px solid var(--border-color);">
                <div class="flex items-center space-x-4 text-sm" style="color: var(--text-secondary);">
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-clock" style="color: var(--accent-color);"></i>
                        <span id="summaryTime">生成时间</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-newspaper" style="color: var(--accent-color);"></i>
                        <span id="summaryNewsCount">新闻数量</span>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <button onclick="copySummary()" class="btn-secondary flex items-center space-x-2">
                        <i class="fas fa-copy"></i>
                        <span>复制</span>
                    </button>
                    <button onclick="sendEmail()" class="btn-primary flex items-center space-x-2">
                        <i class="fas fa-envelope"></i>
                        <span>发送到Kindle</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 音频生成进度模态框 -->
    <div id="podcastModal" class="fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm flex items-center justify-center z-50 hidden">
        <div class="bg-white rounded-3xl p-10 max-w-md w-full mx-4 shadow-2xl border border-gray-100">
            <div class="text-center">
                <div class="relative mb-6">
                    <div class="w-16 h-16 mx-auto">
                        <div class="absolute inset-0 rounded-full border-4 border-gray-200"></div>
                        <div class="absolute inset-0 rounded-full border-4 border-purple-500 border-t-transparent animate-spin"></div>
                        <div class="absolute inset-2 rounded-full bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center">
                            <i id="podcastIcon" class="fas fa-microphone text-white text-lg"></i>
                        </div>
                    </div>
                </div>
                <h3 id="podcastTitle" class="text-xl font-bold text-gray-900 mb-3">正在生成音频</h3>
                <p id="podcastMessage" class="text-gray-600 leading-relaxed mb-4">AI正在为您生成音频对话脚本...</p>
                
                <!-- 进度条 -->
                <div class="w-full bg-gray-200 rounded-full h-2 mb-4">
                    <div id="podcastProgressBar" class="bg-gradient-to-r from-purple-500 to-pink-600 h-2 rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
                </div>
                
                <!-- 进度百分比和详细信息 -->
                <div class="flex justify-between items-center text-sm text-gray-500 mb-4">
                    <span id="podcastProgressPercent">0%</span>
                    <span id="podcastProgressDetail"></span>
                </div>
                
                <div class="flex justify-center">
                    <div class="flex space-x-1">
                        <div class="w-2 h-2 bg-purple-500 rounded-full animate-bounce"></div>
