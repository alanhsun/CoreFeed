<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.siteName || '聚核 CoreFeed · 全球知名信源实时聚合与深读平台' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        parchment: '#f1f5f9',
                        ivory: '#ffffff',
                        sand: '#e2e8f0',
                        brand: '#2563eb',
                        brandLight: '#1d4ed8',
                        ink: '#0f172a',
                        warm: '#1e293b',
                        olive: '#334155',
                        stone: '#64748b'
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="antialiased">
    <div class="kami-page">
        <%
            const todayStr = new Date().toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                weekday: 'long',
                timeZone: 'Asia/Shanghai'
            });
            let updatedTimeStr = '更新于 --:--';
            if (lastUpdated) {
                const d = new Date(lastUpdated);
                if (!isNaN(d.getTime())) {
                    updatedTimeStr = '更新于 ' + d.toLocaleTimeString('zh-CN', {
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: false,
                        timeZone: 'Asia/Shanghai'
                    });
                }
            }
        %>
        <!-- ==================== 简明、克制、高级的纸媒级报头 ==================== -->
        <header class="kami-masthead">
            <div class="kami-masthead-main">
                <!-- 左侧：刊名与副标题 -->
                <div class="kami-brand-group">
                    <div class="flex items-baseline gap-3 flex-wrap">
                        <h1 class="kami-display-title">CoreFeed</h1>
                        <span class="kami-masthead-divider">·</span>
                        <span class="kami-subtitle">全球要闻深度聚合</span>
                    </div>
                    <div class="kami-masthead-meta">
                        <span id="mastheadDate"><%= todayStr %></span>
                        <span class="kami-meta-dot">·</span>
                        <span id="lastUpdateTime"><span id="lastUpdatedLabel"><%= updatedTimeStr %></span></span>
                    </div>
                </div>

                <!-- 右侧：极简核心操作区 -->
                <div class="kami-masthead-actions">
                    <button id="syncGithubBtn" onclick="app.syncFromGitHub()" class="btn-primary" title="从 GitHub 同步最新一期全球要闻与综述">
                        <i id="syncGithubBtnIcon" class="fa-solid fa-rotate text-xs"></i>
                        <span id="syncGithubBtnText">同步最新</span>
                    </button>
                    <button id="btnSettings" onclick="app.openSettingsModal()" class="btn-ghost" title="系统设置">
                        <i class="fa-solid fa-sliders text-xs"></i>
                        <span>设置</span>
                    </button>
                    <button id="btnThemeToggle" onclick="app.toggleTheme()" class="btn-ghost btn-icon-only" title="切换浅色/深色模式" aria-label="切换浅色/深色模式">
                        <i id="themeIcon" class="fa-solid fa-moon text-xs"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- ==================== 主体阅读工作区 ==================== -->
        <main class="space-y-6">

            <!-- 主工作区选项卡与搜索过滤栏 -->
            <div class="kami-tabs-bar">
                <div class="flex flex-wrap items-center gap-2" role="tablist">
                    <button id="tabBtn-feed" onclick="app.switchTab('feed')" class="tab-btn active">
                        <i class="fa-regular fa-newspaper mr-1.5"></i>全球要闻
                    </button>
                    <button id="tabBtn-summary" onclick="app.switchTab('summary')" class="tab-btn">
                        <i class="fa-regular fa-compass mr-1.5"></i>今日综述
                    </button>
                </div>

                <!-- 新闻流搜索与媒体过滤框 -->
                <div id="feedSearchWrapper" class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
                    <select id="sourceFilterSelect" onchange="app.applyFilters()" class="kami-input text-sm py-2 px-3 cursor-pointer">
                        <option value="全部">全部媒体来源</option>
                    </select>
                    <div class="relative flex-1 sm:w-72">
                        <input id="localFilterInput" type="text" placeholder="搜索中文标题、摘要或外媒关键词..."
                            oninput="app.applyFilters()"
                            class="kami-input w-full text-sm py-2 px-3.5">
                    </div>
                </div>
            </div>

            <!-- ==================== TAB 1: 全球新闻卡片流 ==================== -->
            <section id="tabPanel-feed" class="space-y-5">
                <!-- 地域与领域过滤栏 -->
                <div class="kami-card py-3.5 px-4 space-y-3">
                    <div id="regionFilterBar" class="flex flex-wrap items-center gap-2">
                        <!-- 由 main.js 动态渲染地区按钮 -->
                    </div>
                    <div id="categoryFilterBar" class="flex flex-wrap items-center gap-2 pt-2.5" style="border-top: 1px solid var(--border-soft);">
                        <!-- 由 main.js 动态渲染领域按钮 -->
                    </div>
                </div>

                <!-- 新闻情报卡片网格 -->
                <div id="newsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- 由 main.js 渲染卡片 -->
                </div>

                <!-- 加载更多按钮 -->
                <div id="loadMoreContainer" class="text-center pt-4 hidden">
                    <button onclick="app.loadMoreNews()" class="btn-ghost">
                        <span>加载更多要闻</span>
                    </button>
                </div>
            </section>

            <!-- ==================== TAB 2: 今日要闻深度综述 ==================== -->
            <section id="tabPanel-summary" class="hidden space-y-6">
                <div class="kami-card sm:p-10">
                    <div class="pb-6" style="border-bottom: 1px solid var(--border);">
                        <div class="text-xs uppercase tracking-widest mb-2" style="color: var(--stone); font-family: var(--latin-ui);">
                            DAILY GLOBAL SYNTHESIS · 全球态势综述
                        </div>
                        <h2 id="summaryTitle" class="text-2xl sm:text-3xl" style="color: var(--near-black); margin: 0;">
                            <%= summaryArticle ? summaryArticle.title : '今日全球要闻深度综述' %>
                        </h2>
                        <p id="summaryMeta" class="text-xs mt-2" style="color: var(--stone); font-variant-numeric: tabular-nums;">
                            <% if (summaryArticle) { %>
                                生成时间：<%= new Date(summaryArticle.generatedAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' }) %> · 涵盖 <%= (summaryArticle.regions || []).join('、') %> · 共 <%= summaryArticle.wordCount || 0 %> 字
                            <% } else { %>
                                点击右上角「同步最新」获取最新一期全球要闻深度综述
                            <% } %>
                        </p>
                    </div>

                    <!-- 综述正文 -->
                    <div id="summaryBody" class="summary-content mt-8">
                        <% if (summaryArticle && summaryArticle.htmlContent) { %>
                            <%- summaryArticle.htmlContent %>
                        <% } else { %>
                            <div class="py-12" style="color: var(--stone);">
                                <p>暂无今日综述，请点击顶部「同步最新」拉取最新一期全球要闻深度综述。</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- ==================== MODAL 1: 单篇新闻全文深读弹窗 ==================== -->
    <div id="deepReadModal" class="fixed inset-0 z-50 hidden kami-modal-backdrop flex items-center justify-center p-4" onclick="if(event.target===this) app.closeDeepReadModal()">
        <div class="kami-modal-surface max-w-3xl w-full max-h-[88vh] flex flex-col overflow-hidden">
            <div class="px-6 py-5 flex items-start justify-between gap-4" style="border-bottom: 1px solid var(--border); background: var(--ivory);">
                <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1.5">
                        <span class="kami-tag">全文深读</span>
                        <span id="deepReadSourceBadge" class="text-xs" style="color: var(--stone);"></span>
                    </div>
                    <h3 id="deepReadTitle" class="text-lg truncate" style="color: var(--near-black); margin: 0;">正在提取外媒原文...</h3>
                </div>
                <button onclick="app.closeDeepReadModal()" class="p-1.5 cursor-pointer" style="color: var(--stone);">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div id="deepReadBody" class="p-6 sm:p-8 overflow-y-auto space-y-4 text-sm leading-relaxed">
                <!-- 动态加载深读结果 -->
            </div>
            <div class="px-6 py-4 flex items-center justify-between" style="border-top: 1px solid var(--border); background: var(--ivory);">
                <a id="deepReadOriginalLink" href="#" target="_blank" rel="noopener noreferrer" class="text-xs font-medium hover:underline" style="color: var(--brand);">
                    在新窗口打开外媒源站原文 ↗
                </a>
                <button onclick="app.closeDeepReadModal()" class="btn-ghost py-1.5 px-4 text-xs">关闭</button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 2: 极简系统设置弹窗 ==================== -->
    <div id="settingsModal" class="fixed inset-0 z-50 hidden kami-modal-backdrop flex items-center justify-center p-4" onclick="if(event.target===this) app.closeSettingsModal()">
        <div class="kami-modal-surface max-w-lg w-full flex flex-col overflow-hidden">
            <div class="px-6 py-5 flex items-center justify-between" style="border-bottom: 1px solid var(--border);">
                <h3 class="text-base font-bold" style="color: var(--near-black); margin: 0;">系统设置</h3>
                <button onclick="app.closeSettingsModal()" class="p-1.5 cursor-pointer" style="color: var(--stone);" aria-label="关闭设置">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-6 space-y-5 text-sm">
                <!-- 1. GitHub 自动同步与后台检测间隔 -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <div class="font-semibold" style="color: var(--near-black);">GitHub 自动同步</div>
                            <div class="text-xs mt-0.5" style="color: var(--stone);">自动从 GitHub 同步最新精编要闻快照</div>
                        </div>
                        <input id="cfgGithubSyncEnabled" type="checkbox" class="accent-[#2563eb] w-4 h-4 cursor-pointer" <%= (config.githubSyncEnabled !== false) ? 'checked' : '' %>>
                    </div>

                    <div class="flex items-center justify-between gap-4 pt-1">
                        <label for="cfgGithubSyncInterval" class="text-xs" style="color: var(--olive);">后台检测间隔（分钟）</label>
                        <input id="cfgGithubSyncInterval" type="number" min="5" max="1440" value="<%= config.githubSyncIntervalMinutes || 60 %>" class="kami-input w-28 text-xs text-right">
                    </div>
                </div>

                <!-- 2. 每日定时同步时间 -->
                <div class="space-y-3 pt-4" style="border-top: 1px solid var(--border);">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <div class="font-semibold" style="color: var(--near-black);">每日定时同步</div>
                            <div class="text-xs mt-0.5" style="color: var(--stone);">按北京时间每日早、中、晚自动同步更新</div>
                        </div>
                        <input id="cfgAutoUpdateEnabled" type="checkbox" class="accent-[#2563eb] w-4 h-4 cursor-pointer" <%= (config.autoUpdateEnabled !== false) ? 'checked' : '' %>>
                    </div>

                    <div>
                        <label for="cfgUpdateTimes" class="block text-xs mb-1.5" style="color: var(--olive);">每日定时同步时间（逗号分隔）</label>
                        <input id="cfgUpdateTimes" type="text" value="<%= Array.isArray(config.updateTimes) ? config.updateTimes.join(', ') : (config.updateTimes || '08:00, 12:30, 19:30') %>" placeholder="08:00, 12:30, 19:30" class="kami-input w-full text-xs font-mono">
                    </div>
                </div>

                <!-- 3. 简洁的当前同步状态展示 -->
                <div id="modalGithubSyncStatusPanel" class="px-4 py-3 rounded-lg flex items-center justify-between gap-3 text-xs" style="background: var(--inline-code-bg); border: 1px solid var(--border);">
                    <div class="flex items-center gap-2">
                        <span style="color: var(--stone);">同步状态：</span>
                        <strong id="modalSyncStatusText" style="color: var(--near-black);">
                            <%= (typeof githubSync !== 'undefined' && githubSync && githubSync.lastSyncStatus === 'synced') ? '已同步最新' : ((typeof githubSync !== 'undefined' && githubSync && githubSync.lastSyncStatus === 'up-to-date') ? '已是最新' : '就绪') %>
                        </strong>
                    </div>
                    <div style="color: var(--stone); font-variant-numeric: tabular-nums;">
                        最近同步：<span id="modalSyncLastTime"><%= (typeof githubSync !== 'undefined' && githubSync && (githubSync.lastSyncedAt || githubSync.lastSyncCheckAt)) ? new Date(githubSync.lastSyncedAt || githubSync.lastSyncCheckAt).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' }) : (lastUpdated ? new Date(lastUpdated).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' }) : '尚未同步') %></span>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 flex items-center justify-end gap-2.5" style="border-top: 1px solid var(--border); background: var(--inline-code-bg);">
                <button type="button" onclick="app.closeSettingsModal()" class="btn-ghost py-2 px-4 text-xs">取消</button>
                <button type="button" id="btnSaveSettings" onclick="app.saveSettings()" class="btn-primary py-2 px-5 text-xs">保存设置</button>
            </div>
        </div>
    </div>

    <!-- 全局 Toast 通知容器 -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 space-y-2 max-w-sm"></div>

    <!-- 注入服务端初始状态 -->
    <script>
        window.__INITIAL_STATE__ = {
            news: <%- JSON.stringify(news || []) %>,
            totalNews: <%= totalNews || 0 %>,
            displayedNews: <%= displayedNews || 0 %>,
            lastUpdated: <%- JSON.stringify(lastUpdated || null) %>,
            lastPublishedBy: <%- JSON.stringify((typeof lastPublishedBy !== 'undefined' && lastPublishedBy) || null) %>,
            clientId: <%- JSON.stringify((typeof clientId !== 'undefined' && clientId) || null) %>,
            githubSync: <%- JSON.stringify((typeof githubSync !== 'undefined' && githubSync) || null) %>,
            schedule: <%- JSON.stringify((typeof schedule !== 'undefined' && schedule) || null) %>,
            summaryArticle: <%- JSON.stringify(summaryArticle || null) %>,
            sourceMatrix: <%- JSON.stringify(sourceMatrix || []) %>
        };
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
