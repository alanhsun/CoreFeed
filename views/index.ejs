<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.siteName || '聚核 CoreFeed · 全球知名信源 Agent 情报中心' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a'
                        }
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="antialiased selection:bg-blue-600 selection:text-white">
    <!-- 顶部导航栏 -->
    <header class="sticky top-0 z-40 glass-panel border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
            <!-- 品牌 Logo 与名称 -->
            <div class="flex items-center gap-3">
                <img src="/images/logo.png" alt="CoreFeed Logo" class="w-10 h-10 rounded-xl shadow-sm object-cover" onerror="this.style.display='none'">
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-lg sm:text-xl font-bold tracking-tight bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
                            聚核 CoreFeed
                        </h1>
                        <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                            Agent v2.0
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 hidden sm:block">
                        全球知名信源多 Agent 协同搜集 · Jina 全文深读 · 跨源交叉验证
                    </p>
                </div>
            </div>

            <!-- 顶部状态与快捷操作 -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- 连接与模型状态指示 -->
                <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-xs text-slate-600 dark:text-slate-300">
                    <span id="socketStatusDot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="aiModelBadge"><%= config.aiModel || 'MiniMax-M2.5' %></span>
                    <span class="text-slate-300 dark:text-slate-600">|</span>
                    <span>已启用 <strong id="enabledSourcesCount"><%= (sourceMatrix || []).filter(s => s.enabled).length %></strong> 个全球名媒</span>
                </div>

                <!-- 启动 Agent 巡检主按钮 -->
                <button id="btnRunPatrol" onclick="app.triggerAgentPatrol()" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-sm transition-all cursor-pointer">
                    <i id="patrolBtnIcon" class="fa-solid fa-satellite-dish"></i>
                    <span id="patrolBtnText">Agent 全球巡检</span>
                </button>

                <!-- 全球信源矩阵按钮 -->
                <button onclick="app.openSourceMatrixModal()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-500 transition-all" title="管理全球知名信源矩阵">
                    <i class="fa-solid fa-globe text-blue-600 dark:text-blue-400"></i>
                    <span class="hidden sm:inline">信源矩阵</span>
                </button>

                <!-- 设置按钮 -->
                <button onclick="app.openSettingsModal()" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-500 transition-all" title="系统与Agent配置">
                    <i class="fa-solid fa-sliders text-slate-600 dark:text-slate-300"></i>
                </button>

                <!-- 主题切换 -->
                <button onclick="app.toggleTheme()" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-500 transition-all" title="切换深浅色模式">
                    <i id="themeIcon" class="fa-solid fa-moon text-slate-600 dark:text-slate-300"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- 主体内容区 -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- 1. Agent 指挥中心：按需专题深挖 + 4阶段流水线状态面板 -->
        <section class="glass-panel rounded-2xl p-4 sm:p-6 space-y-5">
            <!-- 专题调查搜索栏 -->
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-indigo-600 text-white text-xs">
                            <i class="fa-solid fa-user-secret"></i>
                        </span>
                        <h2 class="text-base sm:text-lg font-bold">Agent 全球知名信源按需搜集与专题整合</h2>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        输入任意国际热点、行业动态或地缘事件，派遣 Agent 实时检索 Reuters、BBC、NYT、AP、彭博等名媒并深读原文生成对比报告
                    </p>
                </div>

                <!-- 快捷热点标签 -->
                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                    <span class="text-slate-400">快速选题:</span>
                    <button onclick="app.quickTopic('中东局势与停火谈判')" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-blue-100 dark:hover:bg-blue-900/40 text-slate-600 dark:text-slate-300 transition">中东局势</button>
                    <button onclick="app.quickTopic('AI 芯片与大模型最新突破')" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-blue-100 dark:hover:bg-blue-900/40 text-slate-600 dark:text-slate-300 transition">AI与半导体</button>
                    <button onclick="app.quickTopic('美联储利率与全球金融市场')" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-blue-100 dark:hover:bg-blue-900/40 text-slate-600 dark:text-slate-300 transition">美联储与宏观</button>
                    <button onclick="app.quickTopic('俄乌冲突与欧洲防务')" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-blue-100 dark:hover:bg-blue-900/40 text-slate-600 dark:text-slate-300 transition">俄乌与欧洲</button>
                </div>
            </div>

            <!-- 专题输入框 -->
            <div class="flex flex-col sm:flex-row gap-2.5">
                <div class="relative flex-1">
                    <i class="fa-solid fa-magnifying-glass-chart absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input id="topicResearchInput" type="text" placeholder="输入您想让 Agent 搜集整合的全球话题（例如：全球关税贸易博弈 / OpenAI 最新动态 / 日本央行政策）..."
                        class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                        onkeydown="if(event.key==='Enter') app.runTopicResearch()">
                </div>
                <div class="flex items-center gap-2">
                    <label class="inline-flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300 px-3 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 cursor-pointer select-none">
                        <input id="chkAuthoritativeOnly" type="checkbox" class="rounded text-blue-600 focus:ring-blue-500">
                        <span>仅限顶级外媒域名</span>
                    </label>
                    <button id="btnTopicResearch" onclick="app.runTopicResearch()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-all whitespace-nowrap cursor-pointer">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <span>派遣 Agent 搜集整合</span>
                    </button>
                </div>
            </div>

            <!-- 4 阶段多 Agent 协作流水线实时状态条 -->
            <div id="agentPipelinePanel" class="pt-3 border-t border-slate-200/70 dark:border-slate-800">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5">
                    <div id="node-scout" class="agent-node rounded-xl p-2.5 border border-slate-200 dark:border-slate-800 flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-radar"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-xs font-bold truncate">1. Scout 巡检员</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">全球名媒并发采集中枢</div>
                        </div>
                    </div>
                    <div id="node-curate" class="agent-node rounded-xl p-2.5 border border-slate-200 dark:border-slate-800 flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-diagram-project"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-xs font-bold truncate">2. Curator 聚类总编</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">跨信源事件合并与甄选</div>
                        </div>
                    </div>
                    <div id="node-compile" class="agent-node rounded-xl p-2.5 border border-slate-200 dark:border-slate-800 flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-book-open-reader"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-xs font-bold truncate">3. Deep-Reader 编译员</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">Jina 全文深读与中文精编</div>
                        </div>
                    </div>
                    <div id="node-summary" class="agent-node rounded-xl p-2.5 border border-slate-200 dark:border-slate-800 flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-pen-nib"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-xs font-bold truncate">4. Chief Editor 主编</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">深度综述与多端分发</div>
                        </div>
                    </div>
                </div>

                <!-- 进度条与实时状态文字 -->
                <div id="liveProgressContainer" class="mt-3 hidden">
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span id="liveProgressText" class="font-medium text-blue-600 dark:text-blue-400">正在初始化 Agent...</span>
                        <span id="liveProgressPercent" class="font-bold">0%</span>
                    </div>
                    <div class="w-full h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                        <div id="liveProgressBar" class="h-full bg-gradient-to-r from-blue-600 to-indigo-600 transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>

                <!-- 底部概览栏与展开实时日志按钮 -->
                <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
                    <div class="flex flex-wrap items-center gap-4">
                        <span><i class="fa-regular fa-clock mr-1"></i>最后更新: <strong id="lastUpdatedLabel"><%= lastUpdated ? new Date(lastUpdated).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' }) : '尚未更新' %></strong></span>
                        <span><i class="fa-solid fa-layer-group mr-1"></i>当前展示: <strong id="displayedCountLabel"><%= displayedNews %></strong> / <strong id="totalPoolCountLabel"><%= totalNews %></strong> 条精选情报</span>
                    </div>
                    <button onclick="app.toggleAgentLogDrawer()" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
                        <i class="fa-solid fa-terminal"></i>
                        <span>查看 Agent 实时执行日志</span>
                    </button>
                </div>

                <!-- 可折叠的 Agent 实时终端日志 -->
                <div id="agentLogDrawer" class="hidden mt-3 p-3 rounded-xl bg-slate-900 text-slate-200 font-mono text-xs max-h-44 overflow-y-auto space-y-1">
                    <div class="text-slate-400">// CoreFeed Multi-Agent 实时遥测日志流...</div>
                </div>
            </div>
        </section>

        <!-- 2. 主工作区选项卡导航 -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-2">
            <div class="flex flex-wrap items-center gap-1.5" role="tablist">
                <button id="tabBtn-feed" onclick="app.switchTab('feed')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold bg-blue-600 text-white shadow-sm transition-all">
                    <i class="fa-regular fa-newspaper mr-1.5"></i>全球情报流
                </button>
                <button id="tabBtn-summary" onclick="app.switchTab('summary')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-all">
                    <i class="fa-solid fa-file-lines mr-1.5"></i>主编深度综述 & Kindle
                </button>
                <button id="tabBtn-research" onclick="app.switchTab('research')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-all">
                    <i class="fa-solid fa-compass-drafting mr-1.5"></i>专题调查报告
                </button>
                <button id="tabBtn-podcast" onclick="app.switchTab('podcast')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-all">
                    <i class="fa-solid fa-headphones-simple mr-1.5"></i>AI 双主播播客
                </button>
            </div>

            <!-- 情报流搜索框 -->
            <div id="feedSearchWrapper" class="relative w-full sm:w-64">
                <i class="fa-solid fa-filter absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="localFilterInput" type="text" placeholder="在当前情报中筛选标题/媒体..."
                    oninput="app.applyFilters()"
                    class="w-full pl-8 pr-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
        </div>

        <!-- ==================== TAB 1: 全球精选情报流 ==================== -->
        <section id="tabPanel-feed" class="space-y-5">
            <!-- 地域与领域过滤栏 -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div id="regionFilterBar" class="flex flex-wrap items-center gap-1.5">
                    <!-- 由 main.js 动态渲染地区按钮 -->
                </div>
                <div id="categoryFilterBar" class="flex flex-wrap items-center gap-1.5">
                    <!-- 由 main.js 动态渲染领域按钮 -->
                </div>
            </div>

            <!-- 新闻情报卡片网格 -->
            <div id="newsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- 由 main.js 渲染卡片 -->
            </div>

            <!-- 加载更多按钮 -->
            <div id="loadMoreContainer" class="text-center pt-2 hidden">
                <button onclick="app.loadMoreNews()" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-500 shadow-sm transition">
                    <i class="fa-solid fa-angles-down text-blue-600"></i>
                    <span>加载更多全球编译情报</span>
                </button>
            </div>
        </section>

        <!-- ==================== TAB 2: 主编深度综述 & Kindle 分发 ==================== -->
        <section id="tabPanel-summary" class="hidden space-y-5">
            <div class="glass-panel rounded-2xl p-5 sm:p-8">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-slate-200 dark:border-slate-800">
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">Chief Editor Synthesis</span>
                        <h2 id="summaryTitle" class="text-xl sm:text-2xl font-bold mt-1">
                            <%= summaryArticle ? summaryArticle.title : '今日全球要闻深度综述' %>
                        </h2>
                        <p id="summaryMeta" class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                            <% if (summaryArticle) { %>
                                生成时间：<%= new Date(summaryArticle.generatedAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' }) %> · 涵盖 <%= (summaryArticle.regions || []).join('、') %> · 共 <%= summaryArticle.wordCount || 0 %> 字
                            <% } else { %>
                                尚未生成今日深度综述，点击右侧按钮立即由主编 Agent 统筹撰写
                            <% } %>
                        </p>
                    </div>

                    <!-- 综述操作按钮组 -->
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="app.generateSummary()" id="btnGenSummary" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 transition cursor-pointer">
                            <i class="fa-solid fa-rotate"></i>
                            <span>生成/刷新综述</span>
                        </button>
                        <button onclick="app.exportEpub()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-500 transition cursor-pointer">
                            <i class="fa-solid fa-book"></i>
                            <span>下载 EPUB 电子书</span>
                        </button>
                        <button onclick="app.sendToKindle()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium bg-amber-500 hover:bg-amber-600 text-white transition cursor-pointer">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>推送至 Kindle / 邮箱</span>
                        </button>
                    </div>
                </div>

                <!-- 综述正文 -->
                <div id="summaryBody" class="summary-content mt-6 prose dark:prose-invert max-w-none">
                    <% if (summaryArticle && summaryArticle.htmlContent) { %>
                        <%- summaryArticle.htmlContent %>
                    <% } else { %>
                        <div class="text-center py-12 text-slate-400">
                            <i class="fa-solid fa-newspaper text-4xl mb-3 block"></i>
                            <p>点击上方「生成/刷新综述」或执行「Agent 全球巡检」，即可生成附带跨信源原文链接的全局深度简报。</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- ==================== TAB 3: Agent 专题调查报告 ==================== -->
        <section id="tabPanel-research" class="hidden space-y-5">
            <div class="glass-panel rounded-2xl p-5 sm:p-8">
                <div id="researchReportContainer">
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-magnifying-glass-chart text-4xl mb-3 block text-indigo-500"></i>
                        <h3 class="text-base font-bold text-slate-700 dark:text-slate-200">派遣 Agent 搜集全球名媒专题情报</h3>
                        <p class="text-xs mt-1 max-w-lg mx-auto">
                            在上方搜索框输入任意国际议题（如“中东局势”、“美联储降息”、“AI芯片管制”），Agent 将自动构造多语种检索词，巡检路透社、BBC、NYT、彭博等信源并使用 Jina Reader 深读全文，在此生成跨信源立场对比报告。
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== TAB 4: AI 双主播播客工作台 ==================== -->
        <section id="tabPanel-podcast" class="hidden space-y-5">
            <div class="glass-panel rounded-2xl p-5 sm:p-8 space-y-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">AI Broadcast Studio</span>
                        <h2 class="text-xl font-bold mt-1">AI 双主播全球新闻联播 (OpenAI-Edge-TTS + FTP)</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                            自动将当日全球精选新闻改编为双人主播对谈脚本，合成 MP3 音频并自动上传至配置的 FTP 服务器
                        </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="app.generatePodcast(false)" id="btnGenPodcast" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition cursor-pointer">
                            <i class="fa-solid fa-microphone-lines"></i>
                            <span>生成今日新闻播客</span>
                        </button>
                        <button onclick="app.generatePodcast(true)" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-indigo-500 transition cursor-pointer">
                            <i class="fa-solid fa-vial"></i>
                            <span>TTS 快速测试</span>
                        </button>
                    </div>
                </div>

                <!-- 播客播放器与脚本展示 -->
                <div id="podcastContentArea" class="space-y-4">
                    <div class="p-4 rounded-xl bg-slate-100 dark:bg-slate-800/70 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xl shadow">
                                <i class="fa-solid fa-tower-broadcast"></i>
                            </div>
                            <div>
                                <div id="podcastTitleLabel" class="font-bold text-sm">
                                    <%= podcastInfo ? podcastInfo.title : '聚核 AI 全球新闻联播' %>
                                </div>
                                <div id="podcastMetaLabel" class="text-xs text-slate-500 dark:text-slate-400">
                                    <% if (podcastInfo) { %>
                                        预估时长: <%= podcastInfo.duration || 0 %> 秒 · 片段数: <%= podcastInfo.stats?.totalSegments || 0 %>
                                    <% } else { %>
                                        尚未生成音频，点击上方按钮开始合成
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <audio id="podcastAudioPlayer" controls class="w-full sm:w-80 h-10" <% if (podcastInfo) { %>src="/api/podcast/complete?t=<%= Date.now() %>"<% } %>></audio>
                    </div>

                    <% if (podcastInfo && podcastInfo.script) { %>
                        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                            <h4 class="text-xs font-bold uppercase text-slate-400 mb-2">双主播对话脚本文稿</h4>
                            <pre id="podcastScriptBox" class="text-xs leading-relaxed whitespace-pre-wrap font-sans text-slate-700 dark:text-slate-300 max-h-80 overflow-y-auto"><%= podcastInfo.script %></pre>
                        </div>
                    <% } else { %>
                        <div id="podcastScriptWrapper" class="hidden p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                            <h4 class="text-xs font-bold uppercase text-slate-400 mb-2">双主播对话脚本文稿</h4>
                            <pre id="podcastScriptBox" class="text-xs leading-relaxed whitespace-pre-wrap font-sans text-slate-700 dark:text-slate-300 max-h-80 overflow-y-auto"></pre>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <!-- ==================== MODAL 1: 单篇新闻 Agent 全文深读弹窗 ==================== -->
    <div id="deepReadModal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-3xl w-full max-h-[88vh] flex flex-col shadow-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-4">
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 text-xs font-semibold rounded bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300">
                            Jina Reader + Agent 全文精读
                        </span>
                        <span id="deepReadSourceBadge" class="text-xs text-slate-500"></span>
                    </div>
                    <h3 id="deepReadTitle" class="text-base sm:text-lg font-bold truncate mt-1">正在深读外媒原文...</h3>
                </div>
                <button onclick="app.closeDeepReadModal()" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div id="deepReadBody" class="p-6 overflow-y-auto space-y-4 text-sm leading-relaxed">
                <!-- 动态加载深读结果 -->
            </div>
            <div class="px-6 py-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50 dark:bg-slate-900/50">
                <a id="deepReadOriginalLink" href="#" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-blue-600 hover:underline">
                    <i class="fa-solid fa-arrow-up-right-from-square mr-1"></i>在新窗口打开外媒原文
                </a>
                <button onclick="app.closeDeepReadModal()" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-200 dark:bg-slate-800">关闭</button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 2: 全球知名信源矩阵管理弹窗 ==================== -->
    <div id="sourceMatrixModal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-4xl w-full max-h-[88vh] flex flex-col shadow-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold">🌍 全球知名信源矩阵管理</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        勾选启用的国际权威媒体，支持官方 RSS、Google News 站点代理（自动突破 Cloudflare）及 Jina 网页抽取
                    </p>
                </div>
                <button onclick="app.closeSourceMatrixModal()" class="p-2 rounded-lg text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-5 flex-1">
                <!-- 快速新增自定义信源 -->
                <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-3">
                    <div class="text-xs font-bold uppercase text-slate-500">➕ 添加自定义国际信源 (RSS 或网站域名)</div>
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-2">
                        <input id="newSourceName" type="text" placeholder="媒体名称 (如 Politico)" class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs">
                        <input id="newSourceDomain" type="text" placeholder="域名 (如 politico.com)" class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs">
                        <input id="newSourceRss" type="text" placeholder="RSS URL (可留空自动走代理)" class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs">
                        <button onclick="app.addCustomSource()" class="px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold">
                            添加至信源矩阵
                        </button>
                    </div>
                </div>

                <!-- 信源列表容器 -->
                <div id="sourceMatrixList" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <!-- 由 main.js 渲染 -->
                </div>
            </div>

            <div class="px-6 py-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50 dark:bg-slate-900/50">
                <div class="flex items-center gap-2">
                    <button onclick="app.toggleAllSources(true)" class="text-xs text-blue-600 hover:underline">全选启用</button>
                    <span class="text-slate-300">|</span>
                    <button onclick="app.toggleAllSources(false)" class="text-xs text-slate-500 hover:underline">全部取消</button>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="app.closeSourceMatrixModal()" class="px-4 py-1.5 rounded-lg text-xs font-medium bg-slate-200 dark:bg-slate-800">取消</button>
                    <button onclick="app.saveSourceMatrix()" class="px-5 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white">保存信源配置</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 3: 系统与 AI 配置弹窗 ==================== -->
    <div id="settingsModal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-2xl w-full max-h-[88vh] flex flex-col shadow-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <h3 class="text-lg font-bold">⚙️ Agent 引擎与系统配置</h3>
                <button onclick="app.closeSettingsModal()" class="p-2 rounded-lg text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto space-y-5 text-xs sm:text-sm">
                <!-- AI 模型设置 -->
                <div class="space-y-3">
                    <h4 class="font-bold text-blue-600 dark:text-blue-400">1. 大语言模型配置 (MiniMax / OpenAI 兼容接口)</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">API Base URL</label>
                            <input id="cfgAiBaseUrl" type="text" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">模型名称 (Model)</label>
                            <input id="cfgAiModel" type="text" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-xs text-slate-500 mb-1">API Key (留空或保持 *** 则不修改原密钥)</label>
                            <input id="cfgAiApiKey" type="password" placeholder="sk-..." class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                    </div>
                </div>

                <!-- Agent 采集与深读参数 -->
                <div class="space-y-3 pt-3 border-t border-slate-200 dark:border-slate-800">
                    <h4 class="font-bold text-blue-600 dark:text-blue-400">2. Agent 巡检与全文深读参数</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">首页精选条数</label>
                            <input id="cfgMaxCurated" type="number" min="10" max="60" value="30" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">Jina 全文深读篇数</label>
                            <input id="cfgDeepReadCount" type="number" min="0" max="25" value="8" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">时效窗口 (小时)</label>
                            <input id="cfgFreshnessHours" type="number" min="12" max="168" value="48" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                    </div>
                </div>

                <!-- 定时任务与 Kindle 收件箱 -->
                <div class="space-y-3 pt-3 border-t border-slate-200 dark:border-slate-800">
                    <h4 class="font-bold text-blue-600 dark:text-blue-400">3. 定时自动巡检与 Kindle 邮件推送</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">每日自动巡检时间 (逗号分隔，如 06:00,16:30)</label>
                            <input id="cfgUpdateTimes" type="text" placeholder="06:00,16:30" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">默认 Kindle / 接收邮箱</label>
                            <input id="cfgRecipientEmail" type="email" placeholder="your_kindle@kindle.com" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-6 py-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-2 bg-slate-50 dark:bg-slate-900/50">
                <button onclick="app.closeSettingsModal()" class="px-4 py-1.5 rounded-lg text-xs font-medium bg-slate-200 dark:bg-slate-800">取消</button>
                <button onclick="app.saveSettings()" class="px-5 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white">保存并生效</button>
            </div>
        </div>
    </div>

    <!-- 全局 Toast 通知容器 -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 space-y-2 max-w-sm"></div>

    <!-- 注入服务端初始状态 -->
    <script>
        window.__INITIAL_STATE__ = {
            news: <%- JSON.stringify(news || []) %>,
            totalNews: <%= totalNews || 0 %>,
            displayedNews: <%= displayedNews || 0 %>,
            lastUpdated: <%- JSON.stringify(lastUpdated || null) %>,
            summaryArticle: <%- JSON.stringify(summaryArticle || null) %>,
            podcastInfo: <%- JSON.stringify(podcastInfo || null) %>,
            sourceMatrix: <%- JSON.stringify(sourceMatrix || []) %>
        };
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
