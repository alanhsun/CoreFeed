<%#
  CoreFeed v2.0 · 全球要闻深度聚合主视图模板 (SSR + Hydration)
  Architecture: Plan 2B (Antigravity Client Compilation + GitHub ag-snapshot Sync Hub)
  Design System: design-taste-frontend v2.5.1 (Swiss Editorial Masthead & 12-Column Asymmetric Bento Grid)
%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="聚核 CoreFeed · 全球权威媒体要闻深度聚合与态势综述平台">
    <title><%= config.siteName || '聚核 CoreFeed · 全球要闻深度聚合' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&family=Noto+Serif+SC:wght@500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        parchment: '#F3F3F1',
                        ivory: '#FFFFFF',
                        sand: '#EAE9E4',
                        brand: '#C83214',
                        brandLight: '#A6260C',
                        ink: '#141413',
                        warm: '#242422',
                        olive: '#383734',
                        stone: '#62605B'
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css?v=2.5.4">
</head>
<body class="antialiased">
    <div class="kami-page">
        <%
            const todayStr = new Date().toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                weekday: 'long',
                timeZone: 'Asia/Shanghai'
            });
            let updatedTimeStr = '更新于 --:--';
            if (lastUpdated) {
                const d = new Date(lastUpdated);
                if (!isNaN(d.getTime())) {
                    updatedTimeStr = '更新于 ' + d.toLocaleTimeString('zh-CN', {
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: false,
                        timeZone: 'Asia/Shanghai'
                    });
                }
            }

            function formatRelativeTimeSSR(dateInput) {
                try {
                    const d = new Date(dateInput);
                    if (isNaN(d.getTime())) return '';
                    const diffMin = Math.floor((Date.now() - d.getTime()) / 60000);
                    if (diffMin < 5) return '刚刚';
                    if (diffMin < 60) return diffMin + ' 分钟前';
                    const diffHr = Math.floor(diffMin / 60);
                    if (diffHr < 24) return diffHr + ' 小时前';
                    return d.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
                } catch (_) {
                    return '';
                }
            }

            const ssrNewsList = Array.isArray(news) ? news : [];
            const ssrHeroItems = ssrNewsList.slice(0, 3);
            const ssrCompactItems = ssrNewsList.slice(3);
        %>

        <header class="kami-masthead">
            <div class="kami-masthead-eyebrow">
                <span class="kami-edition-mark">全球权威外媒精编要闻</span>
                <div class="kami-masthead-meta" style="margin-top: 0;">
                    <span id="mastheadDate"><%= todayStr %></span>
                    <span class="kami-meta-dot">/</span>
                    <span id="lastUpdateTime"><span id="lastUpdatedLabel"><span id="lastUpdatedText"><%= updatedTimeStr %></span></span></span>
                </div>
            </div>

            <div class="kami-masthead-main">
                <div class="kami-brand-group">
                    <div class="flex items-baseline gap-3 flex-wrap">
                        <h1 class="kami-display-title">CoreFeed</h1>
                        <span class="kami-masthead-divider">/</span>
                        <span class="kami-subtitle">全球要闻深度聚合</span>
                    </div>
                </div>

                <div class="kami-masthead-actions">
                    <button id="syncGithubBtn" type="button" onclick="app.syncFromGitHub()" class="btn-primary" title="从 GitHub 同步最新一期全球要闻与综述">
                        <i id="syncGithubBtnIcon" class="fa-solid fa-rotate text-xs"></i>
                        <span id="syncGithubBtnText">同步最新</span>
                    </button>
                    <button id="btnSettings" type="button" onclick="app.openSettingsModal()" class="btn-ghost" title="系统设置">
                        <i class="fa-solid fa-sliders text-xs"></i>
                        <span>设置</span>
                    </button>
                    <button id="btnThemeToggle" type="button" onclick="app.toggleTheme()" class="btn-ghost btn-icon-only" title="切换浅色/深色模式" aria-label="切换浅色/深色模式">
                        <i id="themeIcon" class="fa-solid fa-moon text-xs"></i>
                    </button>
                </div>
            </div>
        </header>

        <main class="space-y-5">
            <div class="kami-tabs-bar">
                <div class="flex flex-wrap items-center gap-2" role="tablist">
                    <button id="tabBtn-feed" type="button" onclick="app.switchTab('feed')" class="tab-btn active">
                        <i class="fa-regular fa-newspaper mr-1.5"></i><span id="tabNews">全球要闻</span>
                    </button>
                    <button id="tabBtn-summary" type="button" onclick="app.switchTab('summary')" class="tab-btn">
                        <i class="fa-regular fa-compass mr-1.5"></i><span id="tabSummary">今日综述</span>
                    </button>
                </div>

                <div id="feedSearchWrapper" class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
                    <select id="sourceFilterSelect" onchange="app.applyFilters()" aria-label="按媒体来源筛选" class="kami-input text-xs sm:text-sm py-2 px-3 cursor-pointer">
                        <option value="全部">全部媒体来源</option>
                    </select>
                    <div id="searchInput" class="taste-search-box flex-1 sm:w-72">
                        <input id="localFilterInput" type="text" aria-label="搜索新闻关键词" placeholder="搜索中文标题、摘要或外媒关键词..."
                            oninput="app.applyFilters()"
                            class="kami-input w-full text-xs sm:text-sm py-2 pl-3.5 pr-8">
                        <button id="btnClearSearch" type="button" onclick="app.clearSearch()" class="taste-search-clear hidden" title="清空搜索" aria-label="清空搜索">
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </button>
                    </div>
                </div>
            </div>

            <section id="tabPanel-feed" class="space-y-5">
                <div id="newsSection" class="space-y-5">
                    <div class="taste-filter-deck space-y-2.5">
                        <div id="regionFilter">
                            <div id="regionFilterBar" class="flex flex-wrap items-center gap-2"></div>
                        </div>
                        <div id="categoryFilter" class="pt-2.5" style="border-top: 1px solid var(--border-subtle);">
                            <div id="categoryFilterBar" class="flex flex-wrap items-center gap-2"></div>
                        </div>
                    </div>

                    <div id="newsGrid" class="bento-news-grid">
                        <% if (ssrNewsList.length === 0) { %>
                            <div class="col-span-full kami-card py-14 text-center space-y-3">
                                <div class="kami-tag mx-auto">暂无要闻</div>
                                <h3 class="text-xl font-bold" style="color: var(--text-primary);">当前暂无可展示的全球要闻</h3>
                                <p class="text-sm max-w-md mx-auto" style="color: var(--text-muted);">请点击右上角「同步最新」拉取最新一期全球权威媒体精编要闻。</p>
                            </div>
                        <% } else { %>
                            <section id="heroCarousel"
                                     class="news-card news-card--lead hero-carousel bento-span-12"
                                     aria-roledescription="carousel"
                                     aria-label="重点要闻轮播"
                                     onmouseenter="app.pauseHeroCarousel()"
                                     onmouseleave="app.resumeHeroCarousel()">
                                <div class="hero-carousel-track">
                                    <% ssrHeroItems.forEach(function(item, slideIdx) {
                                        const indexNum = String(slideIdx + 1).padStart(2, '0');
                                        const title = item.translatedTitle || item.title || '无标题';
                                        const originalTitle = item.translatedTitle && item.translatedTitle !== item.title ? item.title : '';
                                        const summary = item.summary || item.translatedDescription || item.description || '';
                                        const sourceName = (item.source && item.source.name) ? item.source.name : 'Global Media';
                                        const region = item.region || '国际';
                                        const category = item.category || '国际';
                                        const metaBadgeText = category && category !== region ? (region + ' · ' + category) : region;
                                        const timeStr = item.publishedAt ? formatRelativeTimeSSR(item.publishedAt) : '';
                                        const imageUrl = item.urlToImage || '';
                                        const isRemoteHttp = /^https?:\/\//i.test(imageUrl);
                                        const displayImgSrc = isRemoteHttp ? ('/api/image-proxy?url=' + encodeURIComponent(imageUrl)) : imageUrl;
                                        const relatedSources = Array.isArray(item.relatedSources) ? item.relatedSources : [];
                                        const hasMultiSources = relatedSources.length > 0;
                                        const keyPoints = Array.isArray(item.keyPoints) ? item.keyPoints : [];
                                    %>
                                    <article class="hero-carousel-slide <%= slideIdx === 0 ? 'is-active' : '' %>"
                                             data-slide-index="<%= slideIdx %>"
                                             aria-hidden="<%= slideIdx === 0 ? 'false' : 'true' %>">
                                        <div class="hero-slide-top">
                                            <div class="card-meta-header">
                                                <div class="card-meta-left">
                                                    <span class="card-index-num"><%= indexNum %></span>
                                                    <span class="card-meta-sep">/</span>
                                                    <span class="card-source-name" title="<%= sourceName %>"><%= sourceName %></span>
                                                </div>
                                                <div class="hero-meta-right">
                                                    <span class="card-taxonomy-pill"><%= metaBadgeText %></span>
                                                    <% if (ssrHeroItems.length > 1) { %>
                                                        <div class="hero-step-controls" role="group" aria-label="切换重点要闻">
                                                            <button type="button" class="hero-step-btn" onclick="app.prevHeroSlide()" aria-label="上一条要闻" title="上一条要闻">
                                                                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                                                            </button>
                                                            <span class="hero-step-counter tabular-nums"><%= slideIdx + 1 %> / <%= ssrHeroItems.length %></span>
                                                            <button type="button" class="hero-step-btn" onclick="app.nextHeroSlide()" aria-label="下一条要闻" title="下一条要闻">
                                                                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <div class="lead-bento-inner has-media">
                                                <a href="<%= item.url || '#' %>" target="_blank" rel="noopener noreferrer"
                                                   class="card-cover block <%= imageUrl ? '' : 'is-fallback' %>" data-cat="<%= category %>">
                                                    <% if (imageUrl) { %>
                                                        <img src="<%= displayImgSrc %>"
                                                             data-raw-src="<%= imageUrl %>"
                                                             alt="<%= title %>"
                                                             loading="lazy"
                                                             referrerpolicy="no-referrer"
                                                             class="card-cover-img"
                                                             onerror="if(!this.dataset.retried && this.dataset.rawSrc && this.src !== this.dataset.rawSrc){this.dataset.retried='1';this.src=this.dataset.rawSrc;}else{this.parentElement.classList.add('is-fallback');this.remove();}" />
                                                    <% } %>
                                                    <div class="card-cover-fallback">
                                                        <div class="fallback-plate-top">
                                                            <span><%= region %></span>
                                                            <span><%= category %></span>
                                                        </div>
                                                        <div class="fallback-plate-watermark">CoreFeed</div>
                                                        <div class="fallback-plate-bottom">
                                                            <span class="fallback-plate-source"><%= sourceName %></span>
                                                            <span class="fallback-plate-cat">要闻简报</span>
                                                        </div>
                                                    </div>
                                                </a>

                                                <div class="card-body">
                                                    <% if (hasMultiSources) { %>
                                                        <div class="kami-callout flex flex-col gap-0.5">
                                                            <div class="kami-callout-title"><%= relatedSources.length + 1 %> 家权威外媒交叉印证</div>
                                                            <div class="truncate text-xs" style="color: var(--text-body);">
                                                                同题报道：<% relatedSources.forEach(function(r, rIdx) { %><% if (rIdx > 0) { %>、<% } %><% if (r.url) { %><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="hover:underline font-medium" title="<%= r.title || r.name %>"><%= r.name %></a><% } else { %><span><%= r.name %></span><% } %><% }); %>
                                                            </div>
                                                        </div>
                                                    <% } %>

                                                    <div>
                                                        <h3 class="card-title">
                                                            <a href="<%= item.url || '#' %>" target="_blank" rel="noopener noreferrer"><%= title %></a>
                                                        </h3>
                                                        <% if (originalTitle) { %>
                                                            <p class="card-subtitle-en line-clamp-1" title="<%= originalTitle %>"><%= originalTitle %></p>
                                                        <% } %>
                                                    </div>

                                                    <p class="card-summary line-clamp-4"><%= summary %></p>

                                                    <% if (keyPoints.length > 0) { %>
                                                        <ul class="card-keypoints">
                                                            <% keyPoints.forEach(function(kp) { %>
                                                                <li class="card-keypoint-item"><%= kp %></li>
                                                            <% }); %>
                                                        </ul>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-footer">
                                            <span class="card-timestamp"><%= timeStr %></span>
                                            <a href="<%= item.url || '#' %>" target="_blank" rel="noopener noreferrer"
                                                class="btn-source-link">
                                                <span>原文</span>
                                                <span aria-hidden="true">↗</span>
                                            </a>
                                        </div>
                                    </article>
                                    <% }); %>
                                </div>

                                <% if (ssrHeroItems.length > 1) { %>
                                    <div class="hero-carousel-dock" role="tablist" aria-label="切换前三位重点要闻">
                                        <% ssrHeroItems.forEach(function(hItem, hIdx) {
                                            const hNum = String(hIdx + 1).padStart(2, '0');
                                            const hTitle = hItem.translatedTitle || hItem.title || '无标题';
                                            const hSource = (hItem.source && hItem.source.name) ? hItem.source.name : 'Global Media';
                                        %>
                                        <button type="button"
                                                role="tab"
                                                aria-selected="<%= hIdx === 0 ? 'true' : 'false' %>"
                                                data-dock-index="<%= hIdx %>"
                                                onclick="app.goToHeroSlide(<%= hIdx %>)"
                                                class="hero-dock-item <%= hIdx === 0 ? 'is-active' : '' %>">
                                            <div class="hero-dock-meta">
                                                <span class="hero-dock-num"><%= hNum %></span>
                                                <span class="card-meta-sep">/</span>
                                                <span class="hero-dock-source"><%= hSource %></span>
                                            </div>
                                            <div class="hero-dock-title line-clamp-1"><%= hTitle %></div>
                                        </button>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </section>

                            <% ssrCompactItems.forEach(function(item, cIdx) {
                                const idx = cIdx + 3;
                                const indexNum = String(idx + 1).padStart(2, '0');
                                const title = item.translatedTitle || item.title || '无标题';
                                const originalTitle = item.translatedTitle && item.translatedTitle !== item.title ? item.title : '';
                                const summary = item.summary || item.translatedDescription || item.description || '';
                                const sourceName = (item.source && item.source.name) ? item.source.name : 'Global Media';
                                const region = item.region || '国际';
                                const category = item.category || '国际';
                                const metaBadgeText = category && category !== region ? (region + ' · ' + category) : region;
                                const timeStr = item.publishedAt ? formatRelativeTimeSSR(item.publishedAt) : '';
                                const imageUrl = item.urlToImage || '';
                                const isRemoteHttp = /^https?:\/\//i.test(imageUrl);
                                const displayImgSrc = isRemoteHttp ? ('/api/image-proxy?url=' + encodeURIComponent(imageUrl)) : imageUrl;
                                const relatedSources = Array.isArray(item.relatedSources) ? item.relatedSources : [];
                                const hasMultiSources = relatedSources.length > 0;
                                const keyPoints = Array.isArray(item.keyPoints) ? item.keyPoints : [];
                            %>
                            <article class="news-card news-card--compact bento-span-4">
                                <div>
                                    <div class="card-meta-header">
                                        <div class="card-meta-left">
                                            <span class="card-index-num"><%= indexNum %></span>
                                            <span class="card-meta-sep">/</span>
                                            <span class="card-source-name" title="<%= sourceName %>"><%= sourceName %></span>
                                        </div>
                                        <span class="card-taxonomy-pill"><%= metaBadgeText %></span>
                                    </div>

                                    <div class="lead-bento-inner">
                                        <a href="<%= item.url || '#' %>" target="_blank" rel="noopener noreferrer"
                                           class="card-cover block <%= imageUrl ? '' : 'is-fallback' %>" data-cat="<%= category %>">
                                            <% if (imageUrl) { %>
                                                <img src="<%= displayImgSrc %>"
                                                     data-raw-src="<%= imageUrl %>"
                                                     alt="<%= title %>"
                                                     loading="lazy"
                                                     referrerpolicy="no-referrer"
                                                     class="card-cover-img"
                                                     onerror="if(!this.dataset.retried && this.dataset.rawSrc && this.src !== this.dataset.rawSrc){this.dataset.retried='1';this.src=this.dataset.rawSrc;}else{this.parentElement.classList.add('is-fallback');this.remove();}" />
                                            <% } %>
                                            <div class="card-cover-fallback">
                                                <div class="fallback-plate-top">
                                                    <span><%= region %></span>
                                                    <span><%= category %></span>
                                                </div>
                                                <div class="fallback-plate-watermark">CoreFeed</div>
                                                <div class="fallback-plate-bottom">
                                                    <span class="fallback-plate-source"><%= sourceName %></span>
                                                    <span class="fallback-plate-cat">要闻简报</span>
                                                </div>
                                            </div>
                                        </a>

                                        <div class="card-body">
                                            <% if (hasMultiSources) { %>
                                                <div class="kami-callout flex flex-col gap-0.5">
                                                    <div class="kami-callout-title"><%= relatedSources.length + 1 %> 家权威外媒交叉印证</div>
                                                    <div class="truncate text-xs" style="color: var(--text-body);">
                                                        同题报道：<% relatedSources.forEach(function(r, rIdx) { %><% if (rIdx > 0) { %>、<% } %><% if (r.url) { %><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="hover:underline font-medium" title="<%= r.title || r.name %>"><%= r.name %></a><% } else { %><span><%= r.name %></span><% } %><% }); %>
                                                    </div>
                                                </div>
                                            <% } %>

                                            <div>
                                                <h3 class="card-title">
                                                    <a href="<%= item.url || '#' %>" target="_blank" rel="noopener noreferrer"><%= title %></a>
                                                </h3>
                                                <% if (originalTitle) { %>
                                                    <p class="card-subtitle-en line-clamp-1" title="<%= originalTitle %>"><%= originalTitle %></p>
                                                <% } %>
                                            </div>

                                            <p class="card-summary line-clamp-3"><%= summary %></p>

                                            <% if (keyPoints.length > 0) { %>
                                                <ul class="card-keypoints">
                                                    <% keyPoints.forEach(function(kp) { %>
                                                        <li class="card-keypoint-item"><%= kp %></li>
                                                    <% }); %>
                                                </ul>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer">
                                    <span class="card-timestamp"><%= timeStr %></span>
                                    <a href="<%= item.url || '#' %>" target="_blank" rel="noopener noreferrer"
                                        class="btn-source-link">
                                        <span>原文</span>
                                        <span aria-hidden="true">↗</span>
                                    </a>
                                </div>
                            </article>
                            <% }); %>
                        <% } %>
                    </div>

                    <div id="loadMoreContainer" class="text-center pt-4 hidden">
                        <button type="button" onclick="app.loadMoreNews()" class="btn-ghost">
                            <span>加载更多要闻</span>
                        </button>
                    </div>
                </div>
            </section>

            <section id="tabPanel-summary" class="hidden space-y-6">
                <div id="summarySection">
                    <article id="summaryContent" class="kami-card taste-briefing-sheet">
                        <div class="pb-6" style="border-bottom: 1px solid var(--border-hairline);">
                            <h2 id="summaryTitle" class="taste-briefing-title">
                                <%= summaryArticle ? summaryArticle.title : '今日全球要闻深度综述' %>
                            </h2>
                            <p id="summaryMeta" class="text-xs mt-2.5 tabular-nums" style="color: var(--text-muted); font-family: var(--font-mono);">
                                <% if (summaryArticle) { %>
                                    生成时间：<%= new Date(summaryArticle.generatedAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' }) %> / 涵盖 <%= (summaryArticle.regions || []).join('、') %>（<%= summaryArticle.wordCount || 0 %> 字）
                                <% } else { %>
                                    点击右上角「同步最新」获取最新一期全球要闻深度综述
                                <% } %>
                            </p>
                        </div>

                        <div id="summaryBody" class="summary-content mt-8">
                            <% if (summaryArticle && summaryArticle.htmlContent) { %>
                                <%- summaryArticle.htmlContent %>
                            <% } else { %>
                                <div class="py-12" style="color: var(--text-muted);">
                                    <p>暂无今日综述，请点击顶部「同步最新」拉取最新一期全球要闻深度综述。</p>
                                </div>
                            <% } %>
                        </div>
                    </article>
                </div>
            </section>
        </main>
    </div>

    <div id="settingsModal" class="fixed inset-0 z-50 hidden kami-modal-backdrop flex items-center justify-center p-4" onclick="if(event.target===this) app.closeSettingsModal()">
        <form id="settingsForm" class="kami-modal-surface max-w-lg w-full flex flex-col overflow-hidden" onsubmit="event.preventDefault(); app.saveSettings();">
            <div class="px-6 py-5 flex items-center justify-between" style="border-bottom: 1px solid var(--border-hairline);">
                <h3 class="text-base font-bold" style="color: var(--text-primary); margin: 0;">系统设置</h3>
                <button type="button" id="btnCloseSettings" onclick="app.closeSettingsModal()" class="btn-ghost btn-icon-only" aria-label="关闭设置">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <div class="p-6 space-y-5 text-sm">
                <div class="space-y-3">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <div class="font-semibold" style="color: var(--text-primary);">每日定时同步</div>
                            <div class="text-xs mt-0.5" style="color: var(--text-muted);">按北京时间每日早、中、晚自动同步更新</div>
                        </div>
                        <input id="cfgAutoUpdateEnabled" type="checkbox" class="w-4 h-4 cursor-pointer" <%= (config.autoUpdateEnabled !== false) ? 'checked' : '' %>>
                    </div>

                    <div>
                        <label for="cfgUpdateTimes" class="block text-xs mb-1.5" style="color: var(--text-body);">每日定时同步时间（逗号分隔）</label>
                        <input id="cfgUpdateTimes" type="text" value="<%= Array.isArray(config.updateTimes) ? config.updateTimes.join(', ') : (config.updateTimes || '08:00, 12:30, 19:30') %>" placeholder="08:00, 12:30, 19:30" class="kami-input w-full text-xs tabular-nums" style="font-family: var(--font-mono);">
                    </div>
                </div>

                <div id="modalGithubSyncStatusPanel" class="px-4 py-3 rounded-md flex items-center justify-between gap-3 text-xs tabular-nums" style="background: var(--bg-subtle); border: 1px solid var(--border-hairline);">
                    <div class="flex items-center gap-2">
                        <span style="color: var(--text-muted);">同步状态：</span>
                        <span id="modalSyncStatusBadge">
                            <strong id="modalSyncStatusText" style="color: var(--text-primary);">
                                <%= (typeof githubSync !== 'undefined' && githubSync && githubSync.lastSyncStatus === 'synced') ? '已同步最新' : ((typeof githubSync !== 'undefined' && githubSync && githubSync.lastSyncStatus === 'up-to-date') ? '已是最新' : '就绪') %>
                            </strong>
                        </span>
                    </div>
                    <div style="color: var(--text-muted); font-family: var(--font-mono);">
                        最近同步：<span id="modalSyncLastTime"><%= (typeof githubSync !== 'undefined' && githubSync && (githubSync.lastSyncedAt || githubSync.lastSyncCheckAt)) ? new Date(githubSync.lastSyncedAt || githubSync.lastSyncCheckAt).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' }) : (lastUpdated ? new Date(lastUpdated).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' }) : '尚未同步') %></span>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 flex items-center justify-end gap-2.5" style="border-top: 1px solid var(--border-hairline); background: var(--bg-subtle);">
                <button type="button" id="btnCancelSettings" onclick="app.closeSettingsModal()" class="btn-ghost py-2 px-4 text-xs">取消</button>
                <button type="submit" id="btnSaveSettings" class="btn-primary py-2 px-5 text-xs">保存设置</button>
            </div>
        </form>
    </div>

    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 space-y-2 max-w-sm">
        <div id="toast" class="contents"></div>
    </div>

    <script>
        window.__INITIAL_STATE__ = {
            news: <%- JSON.stringify(news || []) %>,
            totalNews: <%= totalNews || 0 %>,
            displayedNews: <%= displayedNews || 0 %>,
            lastUpdated: <%- JSON.stringify(lastUpdated || null) %>,
            lastPublishedBy: <%- JSON.stringify((typeof lastPublishedBy !== 'undefined' && lastPublishedBy) || null) %>,
            clientId: <%- JSON.stringify((typeof clientId !== 'undefined' && clientId) || null) %>,
            githubSync: <%- JSON.stringify((typeof githubSync !== 'undefined' && githubSync) || null) %>,
            schedule: <%- JSON.stringify((typeof schedule !== 'undefined' && schedule) || null) %>,
            summaryArticle: <%- JSON.stringify(summaryArticle || null) %>
        };
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/main.js?v=2.5.4"></script>
</body>
</html>
