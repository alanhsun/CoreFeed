                                    <div class="flex items-center justify-end mb-3">
                                        <button onclick="settingsManager.addUpdateTime()" class="btn-primary btn-sm">
                                            <i class="fas fa-plus mr-1"></i>添加时间
                                        </button>
                                    </div>
                                    <div id="updateTimesList" class="space-y-2">
                                        <!-- 更新时间列表将在这里动态生成 -->
                                    </div>
                                    <p class="text-xs mt-2" style="color: var(--text-secondary);">可以添加多个时间点，系统将在每天的指定时间自动更新新闻</p>
                                </div>
                            </div>
                        </div>
                        

                    </div>
                </div>
                
                <!-- 内容过滤 -->
                <div id="filterContent" class="source-content hidden">
                    <div class="space-y-6">
                        <div class="mb-6">
                            <div class="flex items-center justify-between mb-4">
                                <h4 class="text-lg font-semibold" style="color: var(--text-primary);">关键词屏蔽</h4>
                                <div class="toggle-switch">
                                    <input type="checkbox" id="keywordFilterEnabled" class="toggle-input" onchange="settingsManager.toggleKeywordFilter()">
                                    <div class="toggle-slider">
                                        <div class="toggle-button"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium mb-2" style="color: var(--text-secondary);">屏蔽关键词</label>
                                    <div class="flex space-x-2 mb-3">
                                        <input type="text" id="newKeywordInput" placeholder="输入要屏蔽的关键词" class="flex-1 px-3 py-2 rounded-lg border" style="background: var(--bg-primary); border-color: var(--border-color); color: var(--text-primary);" onkeypress="if(event.key==='Enter') settingsManager.addKeyword()">
                                        <button onclick="settingsManager.addKeyword()" class="btn-primary btn-sm">
                                            <i class="fas fa-plus mr-1"></i>添加
                                        </button>
                                    </div>
                                    <div id="keywordsList" class="space-y-2 max-h-60 overflow-y-auto">
                                        <!-- 关键词列表将在这里动态生成 -->
                                    </div>
                                    <p class="text-xs mt-2" style="color: var(--text-secondary);">包含这些关键词的新闻将被自动过滤掉。关键词匹配不区分大小写，支持中英文。</p>
                                </div>
                                
                                <div class="border-t pt-4" style="border-color: var(--border-color);">
                                    <h5 class="text-md font-medium mb-3" style="color: var(--text-primary);">过滤规则</h5>
                                    <div class="space-y-3">
                                        <div class="flex items-center space-x-3">
                                            <input type="checkbox" id="filterTitle" class="rounded" checked>
                                            <label for="filterTitle" class="text-sm" style="color: var(--text-secondary);">过滤标题中的关键词</label>
                                        </div>
                                        <div class="flex items-center space-x-3">
                                            <input type="checkbox" id="filterContent" class="rounded" checked>
                                            <label for="filterContent" class="text-sm" style="color: var(--text-secondary);">过滤内容中的关键词</label>
                                        </div>
                                        <div class="flex items-center space-x-3">
                                            <input type="checkbox" id="filterSource" class="rounded">
                                            <label for="filterSource" class="text-sm" style="color: var(--text-secondary);">过滤来源中的关键词</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="flex items-center justify-end mt-6 pt-6" style="border-top: 1px solid var(--border-color);">
                <div class="flex items-center space-x-3">
                    <button onclick="resetSources()" class="btn-secondary flex items-center space-x-2">
                        <i class="fas fa-undo"></i>
                        <span>重置</span>
                    </button>
                    <button onclick="saveSources()" class="btn-primary flex items-center space-x-2">
                        <i class="fas fa-save"></i>
                        <span>保存配置</span>
                    </button>
                </div>
            </div>
        </div>
    </div>





    <script>
        // 将服务器端的lastUpdated时间传递给前端
        window.globalLastUpdated = '<%= lastUpdated %>';
    </script>
    <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
    <script src="/js/settings_manager.js?v=<%= appVersion %>"></script>
    <script src="/js/main.js?v=<%= appVersion %>"></script>
</body>
</html>