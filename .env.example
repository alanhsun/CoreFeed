# 服务器配置
PORT=3120
NODE_ENV=development

# ==================== Agent 搜集与整合引擎配置 (CoreFeed v2.0) ====================
AGENT_ENABLED=true
# 启用 Jina Reader (r.jina.ai) 全文穿透深读
JINA_READER_ENABLED=true
# 可选：Jina API Key（留空即使用免费公共端点）
JINA_API_KEY=
# 每次巡检精选展示的新闻数量
AGENT_MAX_CURATED_ARTICLES=30
# 每次巡检自动对前 N 篇核心报道执行全文深读
AGENT_DEEP_READ_COUNT=8
# 全球信源并发巡检数
AGENT_SOURCE_CONCURRENCY=8
# 新闻时效性过滤窗口（小时）
AGENT_FRESHNESS_HOURS=48

# ==================== 大语言模型配置 (MiniMax / DeepSeek / OpenAI 兼容接口) ====================
# 留空时系统仍可正常采集、去重、规则分类并展示全球新闻（仅跳过 AI 中文改写与综述生成）
AI_BASE_URL=https://api.minimaxi.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=MiniMax-M2.5
AI_RATE_LIMIT_RPM=30
AI_RATE_LIMIT_BURST=5
AI_BATCH_SIZE=8

# ==================== 第三方新闻 API 补充源（可选） ====================
NEWS_API_KEY=
NEWS_API_ENABLED=false
NEWS_API_MAX_ARTICLES=15

GNEWS_API_KEY=
GNEWS_ENABLED=false
GNEWS_MAX_ARTICLES=15

# 额外自定义 RSS 源（格式：名称|URL，逗号分隔；系统已内置 30 个全球权威信源矩阵）
RSS_SOURCES=
MAX_ARTICLES_PER_SOURCE=5

# ==================== 定时自动巡检配置 ====================
AUTO_UPDATE_ENABLED=true
UPDATE_TIMES=06:00,16:30
DISABLED_SOURCES=
