# 服务器配置
PORT=3120

# NewsAPI 配置
NEWS_API_KEY=your_newsapi_key_here
NEWS_API_ENABLED=true
# 每次从News API获取的文章数量
NEWS_API_MAX_ARTICLES=20

# Gnews API 配置
GNEWS_API_KEY=your_gnews_api_key_here
GNEWS_ENABLED=false
GNEWS_MAX_ARTICLES=10


# MiniMax AI 配置
# 方案: MiniMax (推荐) - 性价比最高
# 注意：中国用户使用 api.minimaxi.com，国际用户使用 api.minimax.io
AI_BASE_URL=https://api.minimaxi.com/v1
AI_API_KEY=your_minimax_api_key_here
AI_MODEL=MiniMax-M2.5
AI_RATE_LIMIT_RPM=60
AI_RATE_LIMIT_BURST=10

# TTS（OpenAI-Edge-TTS）配置
# 自建 TTS 服务地址
TTS_BASE_URL=http://10.10.10.80:5050/v1/audio/speech
# 模型（保持默认）
TTS_MODEL=tts-1
# 输出格式
TTS_FORMAT=mp3
# 主持人音色
TTS_HOST_VOICE=zh-CN-XiaoxiaoNeural
# 嘉宾音色
TTS_GUEST_VOICE=zh-CN-YunyangNeural
# 如服务需要鉴权，这里设置Bearer Token（可留空）
TTS_API_KEY=

# RSS新闻源（支持两种格式）
# 格式1：简单URL格式（逗号分隔）
# RSS_SOURCES=https://timesofindia.indiatimes.com/rssfeeds/296589292.cms,https://feeds.bbci.co.uk/news/world/rss.xml
# 格式2：自定义名称格式（名称|URL，逗号分隔）
RSS_SOURCES=印度时报|https://timesofindia.indiatimes.com/rssfeeds/296589292.cms,BBC世界新闻|https://feeds.bbci.co.uk/news/world/rss.xml

# 网页抓取源配置（用于没有RSS源的网站）
# 是否启用网页抓取功能
WEB_SCRAPING_ENABLED=false
# 网页抓取源（支持两种格式）
# 格式1：简单URL格式（逗号分隔）
# WEB_SCRAPING_SOURCES=https://apnews.com/world-news
# 格式2：自定义名称格式（名称|URL，逗号分隔）
# 注意: Fox News使用CloudFlare保护，无法直接抓取
# 使用NewsAPI获取Fox News新闻
WEB_SCRAPING_SOURCES=AP News|https://apnews.com/hub/world-news,Japan Today|https://japantoday.com/,Al Jazeera|https://www.aljazeera.com/news/,Channel News Asia|https://www.channelnewsasia.com/us,Taipei Times|https://www.taipeitimes.com/News/front,NHK World|https://www3.nhk.or.jp/nhkworld/en/news/list/
# 网页抓取用户代理
WEB_SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
# 网页抓取超时时间（毫秒）
WEB_SCRAPING_TIMEOUT=30000
# 每个网页抓取源的最大文章数量
WEB_SCRAPING_MAX_ARTICLES=10
# 网页抓取重试次数
WEB_SCRAPING_RETRIES=3
# 网页抓取重试间隔（毫秒）
WEB_SCRAPING_RETRY_DELAY=2000
# 是否遵守robots.txt
WEB_SCRAPING_RESPECT_ROBOTS=true
# 请求间隔时间（毫秒，避免被反爬虫）
WEB_SCRAPING_DELAY=1000

# 默认每个新闻源获取的文章数量
MAX_ARTICLES_PER_SOURCE=5

# 为每个新闻源单独设置获取数量（可选）
# 格式：源名称:数量,源名称:数量
# 对于NewsAPI源，使用源ID（如bbc-news,cnn等）
# 对于RSS源，使用自定义名称（如印度时报,BBC世界新闻等）
# 示例：
# SOURCE_ARTICLE_COUNTS=bbc-news:10,cnn:8,reuters:6,印度时报:12,BBC世界新闻:15
SOURCE_ARTICLE_COUNTS=

# SMTP 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=聚核 (CoreFeed)
SMTP_FROM_EMAIL=your_email@gmail.com

# 默认收件人邮箱（用于摘要报告）
DEFAULT_RECIPIENT_EMAIL=recipient@example.com

# 新闻更新定时配置
# 是否启用自动更新
AUTO_UPDATE_ENABLED=true
# 更新频率（daily, weekly等）
UPDATE_FREQUENCY=daily
# 新闻更新间隔（cron格式）
NEWS_UPDATE_INTERVAL=0 */2 * * *
# 更新时间列表（逗号分隔，如：08:00,20:00）
UPDATE_TIMES=08:00
# 禁用的新闻源（逗号分隔）
DISABLED_SOURCES=

# 网络配置
# 网络请求超时时间（毫秒）
NETWORK_TIMEOUT=30000
# 网络请求重试次数
NETWORK_RETRIES=5
# 重试间隔时间（毫秒）
NETWORK_RETRY_DELAY=2000
# 保持连接活跃
NETWORK_KEEP_ALIVE=true
# 最大并发连接数
NETWORK_MAX_SOCKETS=50

# Socket.IO 配置
# Socket.IO ping超时时间（毫秒）
SOCKETIO_PING_TIMEOUT=60000
# Socket.IO ping间隔时间（毫秒）
SOCKETIO_PING_INTERVAL=25000
# Socket.IO连接超时时间（毫秒）
SOCKETIO_CONNECT_TIMEOUT=45000
# Socket.IO最大缓冲区大小（字节）
SOCKETIO_MAX_BUFFER_SIZE=1000000