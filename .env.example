# 服务器配置
PORT=3120
NODE_ENV=development

# ==================== Agent 搜集与整合引擎配置 (CoreFeed v2.0) ====================
AGENT_ENABLED=true
# 启用 Jina Reader (r.jina.ai) 列表抓取兜底
JINA_READER_ENABLED=true
# 可选：Jina API Key（留空即使用免费公共端点）
JINA_API_KEY=
# 每次巡检精选展示的新闻数量
AGENT_MAX_CURATED_ARTICLES=30
# 全球信源并发巡检数
AGENT_SOURCE_CONCURRENCY=8
# 新闻时效性过滤窗口（小时）
AGENT_FRESHNESS_HOURS=48
# Antigravity 客户端外部发布接口密钥（可选，留空则不强制校验鉴权 Token）
PUBLISH_SECRET=
# CoreFeed 目标网站地址（本机向局域网软路由直推时设为 http://10.10.20.10:3120）
COREFEED_SITE_URL=http://localhost:3120

# ==================== GitHub 快照中转同步配置 (多客户端方案 2B 统一中枢 -> 软路由免公网 IP 同步) ====================
# 路由器端是否自动从 GitHub 拉取云端/多客户端发布的最新精编快照 (默认 true)
GITHUB_SYNC_ENABLED=true
# GitHub 精编快照 Raw 地址 (对应 ag-snapshot 分支下的 latest.json)
GITHUB_SNAPSHOT_URL=https://raw.githubusercontent.com/alanhsun/CoreFeed/ag-snapshot/latest.json
# 路由器后台轻量检查 GitHub 新快照 (ETag/publishedAt) 的轮询间隔（分钟，默认 60 分钟）
GITHUB_SYNC_INTERVAL_MINUTES=60
# Antigravity 客户端执行发布 (ag:publish / ag:auto) 时是否默认推送到 GitHub ag-snapshot 分支 (默认 true，可通过 --no-github 或设为 false 关闭)
GITHUB_PUSH_ENABLED=true
AG_GITHUB_SYNC=true
AG_GITHUB_BRANCH=ag-snapshot
# 多客户端协同防冲突冷却时间窗口（分钟，默认 30 分钟内若远端快照已被其他客户端更新则自动拉取同步而不重复采集）
GITHUB_COOLDOWN_MINUTES=30
# 当前 Antigravity 客户端标识（可选，留空默认使用主机名 os.hostname()，记录在快照 publishedBy 字段）
CLIENT_ID=

# ==================== 大语言模型配置 (OpenAI 兼容接口，可选) ====================
# 支持 OpenAI / MiniMax / Gemini / DeepSeek 等 OpenAI 兼容端点
AI_BASE_URL=https://api.openai.com/v1
# 填入 OpenAI 兼容 API Key（留空则自动启用内置免密钥高速中文翻译与结构化综述兜底）
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_RPM=30
AI_RATE_LIMIT_BURST=5
AI_BATCH_SIZE=8

# ==================== 自定义 RSS 补充源（可选） ====================
# 额外自定义 RSS 源（格式：名称|URL，逗号分隔；系统已内置 37 个全球权威信源矩阵）
RSS_SOURCES=
MAX_ARTICLES_PER_SOURCE=5

# ==================== 定时自动巡检与预采编配置 (每天早中晚三次自动更新) ====================
AUTO_UPDATE_ENABLED=true
# 服务端/软路由每日定时拉取 GitHub 精编快照的时间点（北京时间早 08:00、中 12:30、晚 19:30）
UPDATE_TIMES=08:00,12:30,19:30
# Antigravity 客户端常驻守护进程 (ag-auto-update.js --daemon) 每日提前 20 分钟自动采编并推送 GitHub 的时间点（北京时间 07:40、12:10、19:10，对应 UTC 23:40、04:10、11:10）
AG_UPDATE_TIMES=07:40,12:10,19:10
SCHEDULE_TIMEZONE=Asia/Shanghai
DISABLED_SOURCES=
