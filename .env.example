# 服务器配置
PORT=3120
NODE_ENV=development

# ==================== 原始信源网络搬运配置 (scripts/ag-harvest.js) ====================
# 启用 Jina Reader (r.jina.ai) 列表与原网页文本抓取兜底
JINA_READER_ENABLED=true
# 可选：Jina API Key（留空即使用免费公共端点）
JINA_API_KEY=
# 每次精选发布的新闻展示上限
AGENT_MAX_CURATED_ARTICLES=30
# 全球信源并发拉取数
AGENT_SOURCE_CONCURRENCY=8
# 新闻时效性过滤窗口（小时）
AGENT_FRESHNESS_HOURS=48
# Antigravity 客户端外部直推发布接口密钥（可选，留空则不强制校验鉴权 Token）
PUBLISH_SECRET=
# CoreFeed 目标服务地址（跨节点直推时可设为 http://<YOUR_SERVER_IP>:3120）
COREFEED_SITE_URL=http://localhost:3120

# ==================== GitHub 快照中转同步配置 (Antigravity 客户端 -> 软路由免公网 IP 同步) ====================
# 服务端是否自动从 GitHub 拉取由 Antigravity 客户端大模型精编发布的最新快照 (默认 true)
GITHUB_SYNC_ENABLED=true
# GitHub 精编快照 Raw 地址 (对应 ag-snapshot 分支下的 latest.json)
GITHUB_SNAPSHOT_URL=https://raw.githubusercontent.com/alanhsun/CoreFeed/ag-snapshot/latest.json
# 服务端后台轻量检查 GitHub 新快照 (ETag/publishedAt) 的轮询间隔（分钟，默认 60 分钟）
GITHUB_SYNC_INTERVAL_MINUTES=60
# 本机客户端执行发布 (npm run ag:publish) 时是否默认推送到 GitHub ag-snapshot 分支 (默认 true)
GITHUB_PUSH_ENABLED=true
AG_GITHUB_SYNC=true
AG_GITHUB_BRANCH=ag-snapshot
# 多客户端协同防冲突冷却时间窗口（分钟，默认 30 分钟内若远端快照已被更新则跳过重复采集）
GITHUB_COOLDOWN_MINUTES=30
# 当前采编客户端标识（可选，留空默认使用主机名 os.hostname()，记录在快照 publishedBy 字段）
CLIENT_ID=

# ==================== 自定义 RSS 补充源（可选） ====================
# 额外自定义 RSS 源（格式：名称|URL，逗号分隔；系统已内置 37 个全球权威信源矩阵）
RSS_SOURCES=
MAX_ARTICLES_PER_SOURCE=5
DISABLED_SOURCES=

# ==================== 软路由端每日定时快照同步配置 ====================
AUTO_UPDATE_ENABLED=true
# 软路由服务端每日定时拉取 GitHub 精编快照的时间点（北京时间早 08:00、中 12:30、晚 19:30）
UPDATE_TIMES=08:00,12:30,19:30
SCHEDULE_TIMEZONE=Asia/Shanghai
