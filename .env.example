# 服务器配置
PORT=3120
NODE_ENV=development

# ==================== Agent 搜集与整合引擎配置 (CoreFeed v2.0) ====================
AGENT_ENABLED=true
# 启用 Jina Reader (r.jina.ai) 全文穿透深读
JINA_READER_ENABLED=true
# 可选：Jina API Key（留空即使用免费公共端点）
JINA_API_KEY=
# 每次巡检精选展示的新闻数量
AGENT_MAX_CURATED_ARTICLES=30
# 每次巡检自动对前 N 篇核心报道执行全文深读
AGENT_DEEP_READ_COUNT=8
# 全球信源并发巡检数
AGENT_SOURCE_CONCURRENCY=8
# 新闻时效性过滤窗口（小时）
AGENT_FRESHNESS_HOURS=48
# Antigravity 客户端外部发布接口密钥（可选，留空则不强制校验鉴权 Token）
PUBLISH_SECRET=
# CoreFeed 目标网站地址（本机向局域网软路由直推时设为 http://10.10.20.10:3120）
COREFEED_SITE_URL=http://localhost:3120

# ==================== GitHub 快照中转同步配置 (云端 Antigravity -> 软路由免公网 IP 同步) ====================
# 路由器端是否自动从 GitHub 拉取云端 Antigravity 发布的最新精编快照 (默认 true)
GITHUB_SYNC_ENABLED=true
# GitHub 精编快照 Raw 地址 (对应 ag-snapshot 分支下的 latest.json)
GITHUB_SNAPSHOT_URL=https://raw.githubusercontent.com/alanhsun/CoreFeed/ag-snapshot/latest.json
# 路由器后台检查 GitHub 新快照的轮询间隔（分钟，默认 15 分钟）
GITHUB_SYNC_INTERVAL_MINUTES=15
# 云端 Antigravity 执行发布时是否默认同步推送到 GitHub 快照分支 (也可通过 --github 参数开启)
AG_GITHUB_SYNC=false
AG_GITHUB_BRANCH=ag-snapshot

# ==================== 大语言模型配置 (OpenAI 兼容接口，可选) ====================
# 支持 OpenAI / MiniMax / Gemini / DeepSeek 等 OpenAI 兼容端点
AI_BASE_URL=https://api.openai.com/v1
# 填入 OpenAI 兼容 API Key（留空则自动启用内置免密钥高速中文翻译与结构化综述兜底）
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_RPM=30
AI_RATE_LIMIT_BURST=5
AI_BATCH_SIZE=8

# ==================== 第三方新闻 API 补充源（可选） ====================
NEWS_API_KEY=
NEWS_API_ENABLED=false
NEWS_API_MAX_ARTICLES=15

GNEWS_API_KEY=
GNEWS_ENABLED=false
GNEWS_MAX_ARTICLES=15

# 额外自定义 RSS 源（格式：名称|URL，逗号分隔；系统已内置 30 个全球权威信源矩阵）
RSS_SOURCES=
MAX_ARTICLES_PER_SOURCE=5

# ==================== 定时自动巡检配置 (每天早中晚三次自动更新) ====================
AUTO_UPDATE_ENABLED=true
# 默认每天北京时间早 (08:00)、中 (12:30)、晚 (19:30) 自动采集、编译并更新网站
UPDATE_TIMES=08:00,12:30,19:30
SCHEDULE_TIMEZONE=Asia/Shanghai
DISABLED_SOURCES=
